#ifndef _IN_PATCHNOTESDATA_H
#define _IN_PATCHNOTESDATA_H

// Generated by CMake from patchnotes.txt when it configures, and again whenever
// that file changes. Included by port/src/patchnotes.c alone, so a new entry
// rebuilds one file rather than the whole game the way versioninfo.h would.

// The newest entry's number: which notes this build already contains.
#define PATCHNOTES_NUMBER @PATCHNOTES_NUMBER@

// The whole file, as bytes rather than a string literal so that nothing in it
// - a quote, a backslash, a pair of question marks - needs escaping. The last
// byte is the terminator.
static const unsigned char g_PatchNotesBuiltIn[] = { @PATCHNOTES_BYTES@0x00 };

#endif
