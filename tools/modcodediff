#!/usr/bin/env python3

# Shows what a console mod changed in the game's code, so it can be written
# again in C.
#
# The port runs decomp code rather than the ROM's, so importmod's asset import
# leaves a mod's code changes behind entirely. This is the other half: it pulls
# the MIPS binary out of both ROMs, finds where they differ, and disassembles
# each difference side by side. What comes out is a list of functions and the
# instructions that changed in them - which is the thing you need in front of
# you to make the same change in the port's C.
#
# Two kinds of mod come through here and only one of them can be read this way:
#
#   patched   the stock binary with instructions overwritten in place. Nothing
#             moves, so a word that differs is a change somebody made. GE-X is
#             one of these: 2187 of 452216 words.
#
#   rebuilt   compiled from source, so every address is its own. Diffing says
#             everything changed and means nothing. The performance mod is one
#             of these - its binary is 500KB smaller than stock.
#
# The report says which it is before it says anything else.

import argparse
import importlib.machinery
import importlib.util
import os
import math
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import zlib

# The game binary is paged in at this address; see VM_VIRTUAL_ADDR in
# src/include/lib/vm.h. Every address in the report is one you can look up.
GAME_VRAM = 0x7f000000

# Table of compressed chunks for the game binary, per romid, as tools/extract
# has them. Mods move it, and it is found by its shape when it is not here.
GAME_TABLE = {
    'ntsc-final': 0x4fc40,
    'pal-final':  0x4fc40,
    'jpn-final':  0x4fc40,
}

# Where the N64 tools were put; see the symbol file section in CLAUDE.md.
TOOLCHAIN = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(
        os.path.abspath(__file__)))), 'n64-toolchain')

PD_DIFF_SH = r"""#!/bin/sh
# Read one function of this mod's changes with asm-differ, which aligns the two
# instruction streams rather than pairing them by address - what a rewritten
# function needs.
#
#   ./pd-diff shieldhit_health_to_rgb
#   ./pd-diff 0x295f8 0x29700
#
# The N64 toolchain lives outside the repo; DIFF_PY, DIFF_PYTHON and SYMS
# override where this looks for it.
set -e
cd "$(dirname "$0")"
DIFF_PY="${DIFF_PY:-%s}"
DIFF_PYTHON="${DIFF_PYTHON:-%s}"
SYMS="${SYMS:-%s}"

case "$1" in
    '') echo "usage: $0 <function|start [end]>" >&2; exit 1 ;;
    0x*) exec "$DIFF_PYTHON" "$DIFF_PY" --no-pager "$@" ;;
esac

# a name: its address comes from the symbol file, its end from the next symbol
addr=$(awk -v n="$1" '$2 == n { print $1; exit }' "$SYMS")
if [ -z "$addr" ]; then
    echo "$1 is not in $SYMS" >&2
    exit 1
fi
next=$(awk -v a="$addr" '$1 > a { print $1; exit }' "$SYMS")
shift

start=$(printf '0x%%x' $(( 0x$addr - %#x )))
end=$(printf '0x%%x' $(( 0x${next:-7f1b99e0} - %#x )))

exec "$DIFF_PYTHON" "$DIFF_PY" --no-pager "$start" "$end" "$@"
"""

OBJDUMPS = ('mips-linux-gnu-objdump', 'mips64-linux-gnuabi64-objdump',
            'mipsel-linux-gnu-objdump', 'mips64-elf-objdump', 'mips-elf-objdump')

MIPS_JR_RA = 0x03e00008

# Above this share of differing words the binary was rebuilt rather than patched
# and a diff of it says nothing.
REBUILT_THRESHOLD = 0.25

# Constants worth fingerprinting on. 0 and 1 are everywhere and say nothing;
# anything past 16 bits is usually an address rather than a value.
CONST_MIN = 1
CONST_MAX = 0x10000

# A name is only offered when the best match is this good and this far ahead of
# the next one.
IDENT_MIN_SCORE = 20.0
IDENT_MIN_MARGIN = 1.25

# A region this much of which objdump could not decode is a table, not a
# function, and is reported as words rather than instructions.
DATA_THRESHOLD_PCT = 30

# beq, bne, blez, bgtz, regimm (bltz/bgez), beql..bgtzl
BRANCH_OPS = { 0x01, 0x04, 0x05, 0x06, 0x07, 0x14, 0x15, 0x16, 0x17 }


def die(msg):
    sys.stderr.write('error: %s\n' % msg)
    sys.exit(1)


def load_importmod():
    """importmod already knows how to apply a patch and read a ROM header."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'importmod')
    loader = importlib.machinery.SourceFileLoader('importmod', path)
    spec = importlib.util.spec_from_loader('importmod', loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def be32(buf, ofs):
    return int.from_bytes(buf[ofs:ofs + 4], 'big')


def inflate(buf):
    return zlib.decompressobj(wbits=-15).decompress(buf[5:])


def find_game_table(rom, expected):
    """The chunk table is a run of offsets, each landing on a 1173 header a
    couple of bytes along. Distinctive enough to find when a mod has moved it."""
    def valid(at):
        for i in range(4):
            v = be32(rom, at + i * 4)
            if not 0 < v < 0x400000:
                return False
            if rom[at + v + 2:at + v + 4] != b'\x11\x73':
                return False
        return True

    if expected and valid(expected):
        return expected

    for at in range(0x20000, 0x200000, 4):
        if valid(at):
            return at

    return None


def extract_game(rom, table):
    """The binary, inflated from its chunks. Mirrors tools/extract."""
    out = b''
    i = table

    while True:
        ofs = table + be32(rom, i) + 2
        if rom[ofs:ofs + 2] != b'\x11\x73':
            break
        part = inflate(rom[ofs:ofs + 0x1000])
        out += part
        if len(part) != 0x1000:
            break
        i += 4

    return out


def find_objdump():
    for name in OBJDUMPS:
        try:
            subprocess.run([name, '--version'], capture_output=True, check=True)
            return name
        except (OSError, subprocess.CalledProcessError):
            pass
    die('no MIPS objdump found. Install one of: %s\n'
        '       (debian/ubuntu: apt install binutils-mips-linux-gnu)' % ', '.join(OBJDUMPS))


def disassemble(objdump, path):
    """Address -> instruction text, for the whole binary in one pass."""
    out = subprocess.run(
        [objdump, '-D', '-b', 'binary', '-m', 'mips:4300', '-EB',
         '--adjust-vma=%#x' % GAME_VRAM, path],
        capture_output=True)

    if out.returncode != 0:
        die('objdump failed: %s' % out.stderr.decode('utf-8', 'replace').strip())

    lines = {}
    for line in out.stdout.decode('utf-8', 'replace').splitlines():
        m = re.match(r'\s+([0-9a-f]+):\t[0-9a-f ]+\t(.*)', line)
        if m:
            lines[int(m.group(1), 16)] = ' '.join(m.group(2).split())

    return lines


def function_starts(code):
    """Where each run of code begins, taken as the instruction after a
    `jr ra` and its delay slot.

    A guess, and an honest one: the ROM carries no symbols, and a function with
    more than one return comes out as more than one block. It is enough to group
    a scattering of changed words into the handful of places they belong to,
    which is what the report is for. Pass --map if you have built the decomp and
    want real names.
    """
    starts = [0]

    for i in range(0, len(code) - 8, 4):
        if be32(code, i) == MIPS_JR_RA:
            starts.append(i + 8)

    return starts


def port_functions(path):
    """Every function in the port's own binary, with the constants it mentions.

    The port is this same code compiled for x86 with symbols, so a function that
    carries distinctive numbers - a list of stage ids, a table of weapon flags -
    carries the same ones on both sides. That is enough to put a name to a MIPS
    function without a symbol table for the ROM, when the numbers are unusual
    enough to be worth anything. See identify().
    """
    out = subprocess.run(['objdump', '-d', '--no-show-raw-insn', path], capture_output=True)

    if out.returncode != 0:
        die('could not disassemble %s' % path)

    funcs = {}
    cur = None

    for line in out.stdout.decode('utf-8', 'replace').splitlines():
        m = re.match(r'^[0-9a-f]+ <(.+)>:', line)
        if m:
            cur = m.group(1)
            funcs[cur] = set()
            continue
        if cur is None:
            continue
        for v in re.findall(r'\$0x([0-9a-f]+)', line):
            n = int(v, 16)
            if CONST_MIN < n < CONST_MAX:
                funcs[cur].add(n)

    return funcs


def identify(funcs, document, consts):
    """The port function whose constants best match this MIPS one.

    Scored the way a search engine scores a rare word: a constant that only two
    functions in the binary mention says far more than one that four hundred do.
    Only answered when the best is well clear of the second best, because a
    function with nothing distinctive in it matches everything equally badly.
    """
    if not consts:
        return None

    scored = []

    for name, have in funcs.items():
        score = 0.0
        for c in consts:
            if c in have:
                score += math.log(len(funcs) / (1 + document.get(c, 0)))
        if score:
            scored.append((score, name))

    if not scored:
        return None

    scored.sort(reverse=True)
    best = scored[0]
    second = scored[1][0] if len(scored) > 1 else 0.0

    if best[0] < IDENT_MIN_SCORE or best[0] < second * IDENT_MIN_MARGIN:
        return None

    return best[1], best[0]


def looks_like_data(dis, lo, hi):
    """The game binary carries its tables as well as its code, and a table read
    as instructions is nonsense. objdump says so itself: a word it cannot decode
    comes out as `.word`, and a run of those is data."""
    words = 0
    undecoded = 0

    for addr in range(lo, min(hi, lo + 0x400), 4):
        text = dis.get(addr)
        if text is None:
            continue
        words += 1
        if text.startswith('.word') or text.startswith('.byte') or text.startswith('.short'):
            undecoded += 1

    return words > 0 and undecoded * 100 // words >= DATA_THRESHOLD_PCT


def mips_constants(dis, lo, hi):
    consts = set()

    for addr in range(lo, hi, 4):
        text = dis.get(addr, '')
        for v in re.findall(r'(?:li|addiu|ori|slti|sltiu|andi|xori)\s+[^,]+,(?:[^,]+,)?(-?\d+)', text):
            n = abs(int(v))
            if CONST_MIN < n < CONST_MAX:
                consts.add(n)

    return consts


def default_symbols(romid):
    """The symbol file kept beside this script, if there is one for this ROM.

    It was cut from a matching decomp build's ld map. The game segment sits at a
    fixed address, so its symbols are exact even though the rest of that build
    was not - see the note at the top of the file.
    """
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'pd.%s.sym' % romid)

    return path if os.path.exists(path) else None


def default_files(romid):
    """The source file map kept beside this script, if there is one."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'pd.%s.files' % romid)

    return path if os.path.exists(path) else None


def read_files(path):
    """`<addr> <size> <section> <source file>` per object, cut from the same ld
    map. Which file a change lands in is the thing you actually need - it is the
    file to open in the port - and the section says whether it is code at all,
    which beats guessing from whether objdump could decode it."""
    ranges = []

    with open(path, 'r', errors='replace') as fd:
        for line in fd:
            parts = line.split()
            if len(parts) == 4:
                try:
                    ranges.append((int(parts[0], 16), int(parts[1], 16), parts[2], parts[3]))
                except ValueError:
                    pass

    ranges.sort()

    return ranges


def range_for(ranges, ofs):
    lo, hi = 0, len(ranges)
    while lo < hi:
        mid = (lo + hi) // 2
        if ranges[mid][0] <= ofs:
            lo = mid + 1
        else:
            hi = mid
    if not lo:
        return None
    start, size, section, name = ranges[lo - 1]
    return ranges[lo - 1] if ofs < start + size else None


def file_for(ranges, ofs):
    got = range_for(ranges, ofs)
    return got[3] if got else None


def classify(a, b, offsets):
    """What kind of change this is, which is what says how much work porting it
    is. A region where only the immediates moved is a list of numbers somebody
    edited; one where the opcodes moved is code that was rewritten."""
    kinds = set()

    for ofs in offsets:
        x = int.from_bytes(a[ofs:ofs + 4], 'big')
        y = int.from_bytes(b[ofs:ofs + 4], 'big')
        if (x >> 16) != (y >> 16):
            return 'rewritten'
        op = x >> 26
        kinds.add('branches' if op in BRANCH_OPS else 'constants')

    return 'branches' if 'branches' in kinds else 'constants'


def read_map(path):
    """Symbols from an ld map or from a plain `<addr> <name>` list, for the game
    segment. Anything of that shape counts, which is what ld writes too."""
    syms = []

    with open(path, 'r', errors='replace') as fd:
        for line in fd:
            m = re.match(r'\s*(?:0x)?([0-9a-f]+)\s+([A-Za-z_][\w.]*)\s*$', line)
            if m:
                addr = int(m.group(1), 16)
                if GAME_VRAM <= addr < GAME_VRAM + 0x400000:
                    syms.append((addr - GAME_VRAM, m.group(2)))

    syms.sort()

    return syms


def enclosing(sorted_starts, ofs):
    lo, hi = 0, len(sorted_starts)
    while lo < hi:
        mid = (lo + hi) // 2
        if sorted_starts[mid] <= ofs:
            lo = mid + 1
        else:
            hi = mid
    return sorted_starts[lo - 1] if lo else sorted_starts[0]


def prepare_diff(outdir, a, b, args):
    """Set up asm-differ against these two binaries.

    The side-by-side in this report pairs instructions by address, which is
    right for a region where only the numbers moved and wrong for one that was
    rewritten: a single inserted instruction makes everything after it look
    changed. asm-differ aligns the two sequences instead, and is what you want
    for those. It takes file offsets, so the wrapper converts a name for you.
    """
    os.makedirs(outdir, exist_ok=True)

    with open(os.path.join(outdir, 'stock.bin'), 'wb') as fd:
        fd.write(a)
    with open(os.path.join(outdir, 'mod.bin'), 'wb') as fd:
        fd.write(b)

    with open(os.path.join(outdir, 'diff_settings.py'), 'w') as fd:
        fd.write("""def apply(config, args):
    config['arch'] = 'mips'
    config['baseimg'] = 'stock.bin'
    config['myimg'] = 'mod.bin'
    config['objdump_executable'] = '%s'
    config['build_command'] = ['true']
""" % find_objdump())

    syms = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'pd.%s.sym' % args.romid)
    wrapper = os.path.join(outdir, 'pd-diff')

    with open(wrapper, 'w') as fd:
        fd.write(PD_DIFF_SH % (os.path.join(TOOLCHAIN, 'diff.py'),
                               os.path.join(TOOLCHAIN, 'venv', 'bin', 'python'),
                               syms, GAME_VRAM, GAME_VRAM))

    os.chmod(wrapper, 0o755)

    sys.stderr.write('wrote %s: stock.bin, mod.bin, diff_settings.py, pd-diff\n' % outdir)


# -- the data segment -------------------------------------------------------
#
# The code is half of a mod. The other half is the tables the code reads: the
# weapon definitions, which weapon number points at which of them, the Combat
# Simulator's weapon list, the stage table, the heads and bodies. None of that
# is in the game code segment. It is .data, and .data is its own segment in the
# ROM - one compressed blob at ROMDATA_DATA_OFS - so a diff of the code alone
# misses it entirely. GE-X, for one, renumbers its whole weapon set there.
#
# tools/mkdatasym cuts the segment's symbols out of a decomp build's map, and
# with them a change lands on a name; and for the tables whose layout is known
# it is read back as fields rather than words, which is the form a modconfig
# block wants it in.

DATA_REBUILT_THRESHOLD = 0.5


def default_datasym(romid):
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'pd.%s.datasym' % romid)
    return path if os.path.exists(path) else None


def read_datasym(path):
    """`<addr> <name>` per symbol, at the real ROM's addresses."""
    syms = []
    with open(path, 'r', errors='replace') as fd:
        for line in fd:
            m = re.match(r'\s*(?:0x)?([0-9a-f]+)\s+([A-Za-z_][\w.]*)\s*$', line)
            if m:
                addr = int(m.group(1), 16)
                if 0x80000000 <= addr < 0x80100000:
                    syms.append((addr, m.group(2)))
    syms.sort()
    return syms


def port_header(name):
    here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    path = os.path.join(here, 'src', 'include', name)
    return path if os.path.exists(path) else None


def header_defines(header, prefix):
    """`#define PREFIX_X value` from one of the port's headers, value -> X, so a
    table reads back with the names the port uses. Empty outside the tree."""
    names = {}
    path = port_header(header)
    if not path:
        return names
    with open(path, errors='replace') as fd:
        for line in fd:
            m = re.match(r'#define\s+%s_(\w+)\s+(0x[0-9a-fA-F]+|-?\d+)\b' % prefix, line)
            if m:
                names.setdefault(int(m.group(2), 0), m.group(1))
    return names


def weapon_enum():
    """enum weaponnum in order, from constants.h."""
    names = []
    path = port_header('constants.h')
    if not path:
        return names
    inside = False
    with open(path, errors='replace') as fd:
        for line in fd:
            if line.startswith('enum weaponnum'):
                inside = True
                continue
            if inside:
                if line.startswith('}'):
                    break
                m = re.search(r'\bWEAPON_(\w+)', line)
                if m:
                    names.append(m.group(1))
    return names


