class DataNames:
    """Turns raw field values into the names the port uses for them."""

    def __init__(self, syms, filenames):
        self.syms = syms
        self.starts = [s[0] for s in syms]
        self.bysym = dict(syms)
        self.filenames = filenames or []
        self.weapons = weapon_enum()
        self.ammotypes = header_defines('constants.h', 'AMMOTYPE')
        self.models = header_defines('constants.h', 'MODEL')
        self.features = header_defines('constants.h', 'MPFEATURE')
        self.stages = header_defines('constants.h', 'STAGE')
        self.banks = header_defines('lang.h', 'LANGBANK')

    def symbol(self, addr):
        if not self.syms or addr < self.starts[0] or addr >= self.starts[-1] + 0x10000:
            return None
        start = enclosing(self.starts, addr)
        name = self.bysym[start]
        return name if addr == start else '%s+%x' % (name, addr - start)

    def pointer(self, v):
        if (v >> 24) not in (0x80, 0x7f) or v & 3 or not self.syms:
            return None
        if v < self.starts[0] or v >= self.starts[-1] + 0x10000:
            return None
        start = enclosing(self.starts, v)
        if v - start >= 0x400:
            return None
        return self.symbol(v)

    def fmt(self, kind, v):
        if kind == 'ptr':
            if v == 0:
                return 'NULL'
            return self.symbol(v) or '%08x' % v
        if kind == 'f32':
            return '%g' % struct.unpack('>f', struct.pack('>I', v & 0xffffffff))[0]
        if kind == 'hex':
            return '0x%x' % (v & 0xffffffff)
        if kind == 'text':
            bank, index = v >> 9, v & 0x1ff
            return '%s:%03d' % (self.banks.get(bank, 'bank%02x' % bank), index)
        if kind == 'file':
            if 0 < v < len(self.filenames) and self.filenames[v]:
                return self.filenames[v]
            return 'file %d' % v
        if kind == 'weapon':
            return self.weapons[v] if 0 <= v < len(self.weapons) else 'weapon %d' % v
        if kind == 'ammotype':
            return self.ammotypes.get(v, 'ammo %d' % v) if v else 'none'
        if kind == 'model':
            return self.models.get(v, 'model 0x%x' % v)
        if kind == 'stage':
            return self.stages.get(v, 'stage 0x%x' % v)
        if kind == 'mpfeature':
            has = 'has ' if v & 0x80 else ''
            f = v & 0x7f
            return has + (self.features.get(f, 'feature %d' % f) if f else 'always')
        return str(v)


def field_diff(a, b, base, layout, names):
    """Which fields of one struct differ, as `field old -> new` strings, then
    any differing words the layout does not cover."""
    out = []
    covered = set()
    for ofs, size, signed, field, kind in layout:
        covered.update(range(base + ofs, base + ofs + size))
        x = int.from_bytes(a[base + ofs:base + ofs + size], 'big', signed=bool(signed))
        y = int.from_bytes(b[base + ofs:base + ofs + size], 'big', signed=bool(signed))
        if x != y:
            out.append('%s %s -> %s' % (field, names.fmt(kind, x), names.fmt(kind, y)))
    return out, covered


def data_diff(stock, mod, romid, args):
    """The data segment of both ROMs, and where they differ, with names."""
    im = load_importmod()
    _, a, filesofs = im.find_data_segment(stock, im.ROMS[romid]['data'])
    _, b, _ = im.find_data_segment(mod, im.ROMS[romid]['data'])
    if a is None or b is None:
        return None

    syms = read_datasym(args.datasym) if args.datasym else []
    base = None
    for addr, name in syms:
        if name == 'g_FileTable':
            base = addr - filesofs  # the segment header says where the table is
            break

    _, filenames = im.read_file_table(stock, a, filesofs)

    n = min(len(a), len(b)) & ~3
    changed = [i for i in range(0, n, 4) if a[i:i + 4] != b[i:i + 4]]

    d = {
        'a': a, 'b': b, 'base': base, 'syms': syms, 'changed': changed, 'n': n,
        'names': DataNames(syms, filenames),
        'rebuilt': len(a) != len(b) or len(changed) / max(1, n // 4) > DATA_REBUILT_THRESHOLD,
    }

    # group by enclosing symbol; without symbols, by 64-byte run
    groups = {}
    if syms and base is not None:
        starts = [s[0] for s in syms]
        for ofs in changed:
            groups.setdefault(enclosing(starts, base + ofs), []).append(ofs)
        d['symnames'] = dict(syms)
        d['ends'] = { starts[i]: (starts[i + 1] if i + 1 < len(starts) else starts[-1] + 0x10000)
                      for i in range(len(starts)) }
    else:
        run = None
        for ofs in changed:
            if run is None or ofs - run > 64:
                run = ofs
            groups.setdefault(run, []).append(ofs)
        d['symnames'] = {}
        d['ends'] = {}
    d['groups'] = groups
    return d


def data_summary(say, d, ranges):
    a, b = d['a'], d['b']
    changed, n = d['changed'], d['n']
    say('=' * 72)
    say('Data segment: %d of %d words differ (%.1f%%)%s.'
        % (len(changed), n // 4, 100.0 * len(changed) / max(1, n // 4),
           '' if len(a) == len(b) else ', and it is %+d bytes' % (len(b) - len(a))))
    if d['rebuilt']:
        say('That is a rebuilt segment, not a patched one; the changes below are not')
        say('individually meaningful.')
        say()
        return
    if not changed:
        say()
        return
    if not d['syms']:
        say('No data symbols (tools/pd.<romid>.datasym); see tools/mkdatasym.')
        say()
        return
    say('The tables the code reads - what a weapon number is, what the Combat Simulator')
    say('offers, which stage is which - live here rather than in the code.')
    say()

    groups, base, symnames = d['groups'], d['base'], d['symnames']
    byfile = {}
    for start in groups:
        byfile.setdefault(file_for(ranges, start) or '(unattributed)', []).append(start)

    say('%d source file%s:' % (len(byfile), '' if len(byfile) == 1 else 's'))
    say()
    for path in sorted(byfile, key=lambda p: -sum(len(groups[s]) for s in byfile[p])):
        words = sum(len(groups[s]) for s in byfile[path])
        say('  %-34s %4d word%s in %d symbol%s'
            % (path, words, '' if words == 1 else 's',
               len(byfile[path]), '' if len(byfile[path]) == 1 else 's'))
        shown = sorted(byfile[path], key=lambda s: -len(groups[s]))
        for start in shown[:12]:
            say('      %-36s %4d  at %08x' % (symnames.get(start, 'data_%08x' % start), len(groups[start]), start))
        if len(shown) > 12:
            say('      ... and %d more' % (len(shown) - 12))
        say()


def data_details(say, d):
    if d['rebuilt'] or not d['changed'] or not d['syms']:
        return
    a, b, base, names = d['a'], d['b'], d['base'], d['names']
    groups, symnames, ends = d['groups'], d['symnames'], d['ends']

    say()
    say('=' * 72)
    say('DATA SEGMENT')
    say('=' * 72)

    for start in sorted(groups):
        sym = symnames.get(start, 'data_%08x' % start)
        ofs = start - base
        size = ends.get(start, start + 4) - start
        offsets = groups[start]
        say()

        table = TABLES.get(sym)
        layout = next((l for p, l, _ in STRUCTS if sym.startswith(p)), None)
        kind = next((k for p, _, k in STRUCTS if sym.startswith(p)), None)

        if table:
            layout, elem, indexkind = table
            count = size // elem
            hit = sorted(set((o - ofs) // elem for o in offsets if 0 <= o - ofs < count * elem))
            say('%s   (%08x, %d entries of %d bytes, %d changed)' % (sym, start, count, elem, len(hit)))
            say('-' * 72)
            for i in hit:
                label = '[%d]' % i if indexkind is None else '[%d %s]' % (i, names.fmt(indexkind, i))
                at = ofs + i * elem
                if layout == 'ptrtable':
                    x = int.from_bytes(a[at:at + 4], 'big')
                    y = int.from_bytes(b[at:at + 4], 'big')
                    say('  %-24s %s -> %s' % (label, names.fmt('ptr', x), names.fmt('ptr', y)))
                else:
                    fields, _ = field_diff(a, b, at, layout, names)
                    say('  %-24s %s' % (label, ', '.join(fields) if fields else '(padding)'))
            continue

        if layout:
            fields, covered = field_diff(a, b, ofs, layout, names)
            say('%s   (%08x, %s, %d changed)' % (sym, start, kind, len(offsets)))
            say('-' * 72)
            for f in fields:
                say('  ' + f)
            extra = [o for o in offsets if o not in covered]
            for o in extra[:8]:
                say('  +0x%02x  %08x -> %08x' % (o - ofs, int.from_bytes(a[o:o + 4], 'big'), int.from_bytes(b[o:o + 4], 'big')))
            if len(extra) > 8:
                say('  ... and %d more words' % (len(extra) - 8))
            continue

        say('%s   (%08x, %d of %d words changed)' % (sym, start, len(offsets), size // 4))
        say('-' * 72)
        for o in offsets[:16]:
            x = int.from_bytes(a[o:o + 4], 'big')
            y = int.from_bytes(b[o:o + 4], 'big')
            # a word that lands on a symbol, aligned, is probably a pointer to it;
            # one that lands 0xf6 bytes into a pointer table is packed data
            px = names.pointer(x)
            py = names.pointer(y)
            say('  +0x%04x  %08x -> %08x%s' % (o - ofs, x, y, '   %s -> %s' % (px or '', py or '') if px or py else ''))
        if len(offsets) > 16:
            say('  ... and %d more words' % (len(offsets) - 16))



def main():
    ap = argparse.ArgumentParser(
        description="Disassemble what a console mod changed in the game's code.")
    ap.add_argument('--rom', required=True, help='the stock ROM')
    ap.add_argument('--patch', help='the mod patch (xdelta, BPS or IPS)')
    ap.add_argument('--patched-rom', help='an already patched ROM, instead of --patch')
    ap.add_argument('--out', help='write the report here (default: stdout)')
    ap.add_argument('--map', dest='mapfile',
                    help='an ld map or symbol list for real names (default: tools/pd.<romid>.sym)')
    ap.add_argument('--no-symbols', action='store_true', help='ignore the bundled symbol and source file lists')
    ap.add_argument('--files', dest='filesfile', help='a source file list (default: tools/pd.<romid>.files)')
    ap.add_argument('--port-binary', help="the port's own executable, to guess names from its symbols")
    ap.add_argument('--context', type=int, default=2, help='unchanged instructions to show around a change')
    ap.add_argument('--summary', action='store_true', help='list the changed functions and stop')
    ap.add_argument('--prepare-diff', metavar='DIR',
                    help='write both binaries and an asm-differ setup here, for reading a rewritten function')
    ap.add_argument('--datasym', help='data segment symbols (default: tools/pd.<romid>.datasym)')
    args = ap.parse_args()

    if bool(args.patch) == bool(args.patched_rom):
        die('pass exactly one of --patch or --patched-rom.')

    im = load_importmod()

    with open(args.rom, 'rb') as fd:
        stock = fd.read()

    romid = im.identify_rom(stock)
    if romid is None:
        die('%s is not a supported Perfect Dark ROM.' % args.rom)

    workdir = tempfile.mkdtemp(prefix='modcodediff')

    try:
        if args.patch:
            mod, kind = im.apply_patch(args.rom, stock, args.patch, workdir)
        else:
            with open(args.patched_rom, 'rb') as fd:
                mod = fd.read()
            kind = 'pre-patched ROM'

        report(stock, mod, romid, kind, workdir, args)
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


def report(stock, mod, romid, kind, workdir, args):
    args.romid = romid
    out = open(args.out, 'w') if args.out else sys.stdout

    def say(msg=''):
        print(msg, file=out)

    stocktab = find_game_table(stock, GAME_TABLE.get(romid))
    modtab = find_game_table(mod, GAME_TABLE.get(romid))

    if stocktab is None or modtab is None:
        die('could not find the game binary in the %s ROM.'
            % ('stock' if stocktab is None else 'patched'))

    a = extract_game(stock, stocktab)
    b = extract_game(mod, modtab)

    say('stock ROM:  %s (%s), game binary at %06x, %d bytes' % (args.rom, romid, stocktab, len(a)))
    say('patched:    %s (%s), game binary at %06x, %d bytes' % (args.patch or args.patched_rom, kind, modtab, len(b)))
    say('loaded at:  %08x' % GAME_VRAM)
    say()
    if not args.datasym and not args.no_symbols:
        args.datasym = default_datasym(romid)
    if not args.filesfile and not args.no_symbols:
        args.filesfile = default_files(romid)
    data = data_diff(stock, mod, romid, args)
    dataranges = read_files(args.filesfile) if args.filesfile else []

    n = min(len(a), len(b))
    changed = [i for i in range(0, n & ~3, 4) if a[i:i + 4] != b[i:i + 4]]
    share = len(changed) / max(1, (n // 4))

    if len(a) != len(b) or share > REBUILT_THRESHOLD:
        say('%d of %d words differ (%.1f%%), and the binary is %+d bytes.'
            % (len(changed), n // 4, share * 100, len(b) - len(a)))
        say()
        say('This mod was rebuilt from source rather than patched in place, so every')
        say('address in it is its own and a diff against the stock binary says nothing.')
        say('What it changed can only come from its own source, or from watching it run.')
        say()
        if data:
            data_summary(say, data, dataranges)
        if out is not sys.stdout:
            out.close()
        return

    say('%d of %d words differ (%.2f%%). Same length, so this mod was patched in'
        % (len(changed), n // 4, share * 100))
    say('place: every differing word is an instruction somebody changed.')
    say()

    if not changed:
        if out is not sys.stdout:
            out.close()
        return

    if not args.mapfile and not args.no_symbols:
        args.mapfile = default_symbols(romid)

    if not args.filesfile and not args.no_symbols:
        args.filesfile = default_files(romid)

    ranges = dataranges

    if args.mapfile:
        syms = read_map(args.mapfile)
        starts = [s[0] for s in syms]
        names = dict(syms)
    else:
        starts = function_starts(a)
        names = {}

    groups = {}
    for ofs in changed:
        groups.setdefault(enclosing(starts, ofs), []).append(ofs)

    if args.prepare_diff:
        prepare_diff(args.prepare_diff, a, b, args)

    apath = os.path.join(workdir, 'stock.bin')
    bpath = os.path.join(workdir, 'mod.bin')
    with open(apath, 'wb') as fd:
        fd.write(a)
    with open(bpath, 'wb') as fd:
        fd.write(b)

    objdump = find_objdump()
    da = disassemble(objdump, apath)
    db = disassemble(objdump, bpath)

    ends = {}
    for i, start in enumerate(starts):
        ends[start] = starts[i + 1] if i + 1 < len(starts) else len(a)

    # the section a region is in when the map knows it, and objdump's opinion
    # of whether it decodes when it does not
    isdata = {}
    for start in groups:
        got = range_for(ranges, GAME_VRAM + start) if ranges else None
        if got:
            isdata[start] = got[2] != 'text'
        else:
            isdata[start] = looks_like_data(da, GAME_VRAM + start, GAME_VRAM + ends.get(start, start + 0x400))

    for start in groups:
        if isdata[start] and start not in names:
            names[start] = 'data_%08x' % (GAME_VRAM + start)

    guessed = {}

    if args.port_binary and not args.mapfile:
        funcs = port_functions(args.port_binary)
        document = {}
        for have in funcs.values():
            for c in have:
                document[c] = document.get(c, 0) + 1

        for start in groups:
            if isdata[start]:
                continue  # a table's numbers are its content, not its fingerprint
            consts = mips_constants(da, GAME_VRAM + start, GAME_VRAM + ends.get(start, start + 0x400))
            guess = identify(funcs, document, consts)
            if guess:
                guessed[start] = guess

        # one name, one region: where two regions want the same name only the
        # better match keeps it, the other having matched on nothing particular
        best = {}
        for start, (name, score) in guessed.items():
            if name not in best or score > guessed[best[name]][1]:
                best[name] = start

        for name, start in best.items():
            names[start] = name + '?'

    ndata = sum(1 for s in groups if isdata[s])
    nnamed = sum(1 for s in groups if s in names and not isdata[s])

    kinds = { start: ('data' if isdata[start] else classify(a, b, groups[start])) for start in groups }

    say('%d region%s changed - %d code, %d data%s.'
        % (len(groups), '' if len(groups) == 1 else 's', len(groups) - ndata, ndata,
           ', %d named from the port binary' % nnamed if args.port_binary else ''))

    counts = {}
    for start in groups:
        counts[kinds[start]] = counts.get(kinds[start], 0) + 1
    say('Of the code: %s.' % ', '.join('%d %s' % (counts[k], k)
                                       for k in ('constants', 'branches', 'rewritten') if k in counts))
    say()
    say('constants  only the numbers changed - usually a table to edit, not code to write')
    say('branches   the same tests, jumping elsewhere')
    say('rewritten  different instructions')
    say()

    if ranges:
        byfile = {}
        for start in groups:
            byfile.setdefault(file_for(ranges, GAME_VRAM + start) or '(unattributed)', []).append(start)

        say('%d source file%s:' % (len(byfile), '' if len(byfile) == 1 else 's'))
        say()

        here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

        for path in sorted(byfile, key=lambda p: -sum(len(groups[s]) for s in byfile[p])):
            words = sum(len(groups[s]) for s in byfile[path])
            gone = '' if path == '(unattributed)' or os.path.exists(os.path.join(here, path)) \
                    else '   [not in this tree]'
            say('  %-34s %4d word%s in %d region%s%s'
                % (path, words, '' if words == 1 else 's',
                   len(byfile[path]), '' if len(byfile[path]) == 1 else 's', gone))

            for start in sorted(byfile[path], key=lambda s: -len(groups[s])):
                say('      %-30s %4d  %s at %08x'
                    % (names.get(start, 'func_%08x' % (GAME_VRAM + start)),
                       len(groups[start]), kinds[start], GAME_VRAM + groups[start][0]))
            say()
    else:
        for start in sorted(groups, key=lambda s: -len(groups[s])):
            say('  %-34s %4d %s  %s at %08x'
                % (names.get(start, 'func_%08x' % (GAME_VRAM + start)),
                   len(groups[start]), 'words' if isdata[start] else 'instructions',
                   kinds[start], GAME_VRAM + groups[start][0]))

    if data:
        data_summary(say, data, ranges)

    if args.summary:
        if out is not sys.stdout:
            out.close()
        return

    say()
    say('=' * 72)

    for start in sorted(groups):
        offsets = groups[start]
        say()
        say('%s   (%08x, %d changed, %s%s)'
            % (names.get(start, 'func_%08x' % (GAME_VRAM + start)),
               GAME_VRAM + start, len(offsets), kinds[start],
               ' in %s' % file_for(ranges, GAME_VRAM + start)
               if ranges and file_for(ranges, GAME_VRAM + start) else ''))
        say('-' * 72)

        wanted = set()
        for ofs in offsets:
            for k in range(-args.context, args.context + 1):
                wanted.add(ofs + k * 4)

        prev = None
        for ofs in sorted(wanted):
            if ofs < 0 or ofs >= n:
                continue
            addr = GAME_VRAM + ofs
            if prev is not None and ofs != prev + 4:
                say('        ...')
            prev = ofs
            if isdata[start]:
                # words, because that is what a table is
                if a[ofs:ofs + 4] == b[ofs:ofs + 4]:
                    say('        %08x  %08x' % (addr, int.from_bytes(a[ofs:ofs + 4], 'big')))
                else:
                    say('      - %08x  %08x' % (addr, int.from_bytes(a[ofs:ofs + 4], 'big')))
                    say('      + %08x  %08x' % (addr, int.from_bytes(b[ofs:ofs + 4], 'big')))
            elif a[ofs:ofs + 4] == b[ofs:ofs + 4]:
                say('        %08x  %s' % (addr, da.get(addr, '?')))
            else:
                say('      - %08x  %s' % (addr, da.get(addr, '?')))
                say('      + %08x  %s' % (addr, db.get(addr, '?')))

    if data:
        data_details(say, data)

    if out is not sys.stdout:
        out.close()
        print('wrote %s' % args.out)


if __name__ == '__main__':
    main()
