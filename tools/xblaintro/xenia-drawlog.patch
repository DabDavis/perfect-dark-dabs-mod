+// PD port research hook (not upstream). With PD_DRAWLOG naming a file, every
+// draw writes one record there: the frame number (counted at each XE_SWAP),
+// the raw VGT_DRAW_INITIATOR (index count in its top 16 bits), the active
+// vertex and pixel shader objects, vertex float constants c0-c63, pixel float
+// constants c0-c15, registers 0x2100-0x211F (blend colour, viewport) and
+// 0x2200-0x220B (depth, blend and colour control, cull mode). Logging stops
+// after PD_DRAWLOG_FRAMES frames (6000 when unset).
+static FILE*& PdDrawLogFile() {
+  static FILE* file = nullptr;
+  return file;
+}
+static uint32_t& PdDrawLogFrame() {
+  static uint32_t frame = 0;
+  return frame;
+}
+static FILE* PdDrawLogOpen() {
+  static int state = 0;  // 0 not asked yet, 1 logging, -1 off
+  if (state == 0) {
+    const char* path = std::getenv("PD_DRAWLOG");
+    PdDrawLogFile() = path ? std::fopen(path, "wb") : nullptr;
+    state = PdDrawLogFile() ? 1 : -1;
+  }
+  return state > 0 ? PdDrawLogFile() : nullptr;
+}
+static uint32_t PdDrawLogMaxFrames() {
+  static uint32_t max_frames = 0;
+  if (!max_frames) {
+    const char* env = std::getenv("PD_DRAWLOG_FRAMES");
+    max_frames = env ? uint32_t(std::strtoul(env, nullptr, 10)) : 6000;
+  }
+  return max_frames;
+}
+// A host timestamp at each swap, to PD_DRAWLOG with ".swaps" added: u32 frame
+// and u64 microseconds of steady_clock. The game's clock follows vblanks,
+// which Xenia raises at 60 Hz of real time, so this is what turns frames into
+// the game's ticks when the emulator draws slower than 60.
+static void PdDrawLogSwap() {
+  PdDrawLogFrame()++;
+  if (FILE* file = PdDrawLogOpen()) {
+    std::fflush(file);
+    static FILE* swaps = nullptr;
+    if (!swaps) {
+      std::string path = std::string(std::getenv("PD_DRAWLOG")) + ".swaps";
+      swaps = std::fopen(path.c_str(), "wb");
+    }
+    if (swaps && PdDrawLogFrame() <= PdDrawLogMaxFrames()) {
+      const uint32_t frame = PdDrawLogFrame();
+      const uint64_t micros = uint64_t(
+          std::chrono::duration_cast<std::chrono::microseconds>(
+              std::chrono::steady_clock::now().time_since_epoch())
+              .count());
+      std::fwrite(&frame, 4, 1, swaps);
+      std::fwrite(&micros, 8, 1, swaps);
+      std::fflush(swaps);
+    }
+  }
+}
+// The second version of the record ('PDD2') adds the 32 texture fetch
+// constants (0x4800-0x48BF) and, for each shader, the fetch constant each of
+// its texture bindings reads (8 bytes, 0xFF for none or not yet analysed).
+static void PdDrawLogBindings(Shader* shader, uint8_t* out) {
+  std::memset(out, 0xFF, 8);
+  if (!shader || !shader->is_ucode_analyzed()) {
+    return;
+  }
+  size_t i = 0;
+  for (const auto& binding : shader->texture_bindings()) {
+    if (i < 8) {
+      out[i++] = uint8_t(binding.fetch_constant);
+    }
+  }
+}
+static void PdDrawLogDraw(const uint32_t* values, uint32_t initiator,
+                          Shader* vertex_shader, Shader* pixel_shader) {
+  FILE* file = PdDrawLogOpen();
+  static const uint32_t first_frame = [] {
+    const char* env = std::getenv("PD_DRAWLOG_FIRST");
+    return env ? uint32_t(std::strtoul(env, nullptr, 10)) : 0u;
+  }();
+  if (!file || PdDrawLogFrame() >= PdDrawLogMaxFrames() ||
+      PdDrawLogFrame() < first_frame) {
+    return;
+  }
+  // 'PDD3': PDD2 plus pixel float constants c192-c199 (the lighting block
+  // GoldenEye XBLA's shaders read at c196-c198) at the end
+  const uint32_t head[3] = {0x33444450u, PdDrawLogFrame(), initiator};
+  const uint64_t shaders[2] = {uint64_t(uintptr_t(vertex_shader)),
+                               uint64_t(uintptr_t(pixel_shader))};
+  uint8_t bindings[16];
+  PdDrawLogBindings(vertex_shader, bindings);
+  PdDrawLogBindings(pixel_shader, bindings + 8);
+  std::fwrite(head, 4, 3, file);
+  std::fwrite(shaders, 8, 2, file);
+  std::fwrite(values + 0x4000, 4, 256, file);
+  std::fwrite(values + 0x4400, 4, 64, file);
+  std::fwrite(values + 0x2100, 4, 32, file);
+  std::fwrite(values + 0x2200, 4, 12, file);
+  std::fwrite(values + 0x4800, 4, 192, file);
+  std::fwrite(bindings, 1, 16, file);
+  std::fwrite(values + 0x4000 + (256 + 192) * 4, 4, 32, file);
+}
+// The buffers of every draw with depth testing off (RB_DEPTHCONTROL z_enable
+// clear - skies, the HUD), to PD_DRAWLOG with ".vb" added. One record each:
+// 'PDVB', the draw's index in the main log, frame, index format (0 u16, 1
+// u32), index endianness, index byte count, then the raw index bytes; then the
+// binding count and, per vertex binding, fetch constant, stride in words, word
+// count, and the raw vertex words (guest byte order). Called for every draw
+// right after PdDrawLogDraw, so its own count is the main log's record index.
+struct PdDrawLogIndices {
+  uint32_t guest_base;
+  uint32_t count;
+  bool wide;
+  uint32_t endianness;
+};
+static void PdDrawLogBuffers(Memory* memory, RegisterFile* regs,
+                             const PdDrawLogIndices* index_buffer,
+                             Shader* vertex_shader) {
+  static uint32_t draw = 0;
+  const uint32_t this_draw = draw++;
+  if (!PdDrawLogOpen() || PdDrawLogFrame() >= PdDrawLogMaxFrames()) {
+    return;
+  }
+  if (regs->values[0x2200] & 2) {
+    return;
+  }
+  static FILE* file = nullptr;
+  if (!file) {
+    std::string path = std::string(std::getenv("PD_DRAWLOG")) + ".vb";
+    file = std::fopen(path.c_str(), "wb");
+    if (!file) {
+      return;
+    }
+  }
+  uint32_t max_index = 0;
+  uint32_t index_bytes = 0;
+  const uint8_t* index_data = nullptr;
+  uint32_t index_format = 0, index_endian = 0;
+  if (index_buffer && index_buffer->guest_base && index_buffer->count) {
+    const bool wide = index_buffer->wide;
+    index_format = wide ? 1 : 0;
+    index_endian = uint32_t(index_buffer->endianness);
+    index_bytes = index_buffer->count * (wide ? 4 : 2);
+    if (index_bytes > (1u << 20)) {
+      return;
+    }
+    index_data = memory->TranslatePhysical(index_buffer->guest_base);
+    for (uint32_t i = 0; i < index_buffer->count; i++) {
+      uint32_t v;
+      if (wide) {
+        v = uint32_t(index_data[i * 4]) << 24 | uint32_t(index_data[i * 4 + 1]) << 16 |
+            uint32_t(index_data[i * 4 + 2]) << 8 | index_data[i * 4 + 3];
+      } else {
+        v = uint32_t(index_data[i * 2]) << 8 | index_data[i * 2 + 1];
+      }
+      // Both byte orders are looked at, since a swap mode of zero is rare.
+      uint32_t s = wide ? xe::byte_swap(v) : uint32_t(xe::byte_swap(uint16_t(v)));
+      uint32_t m = v < s ? v : s;
+      if (m > max_index && m < 65536) {
+        max_index = m;
+      }
+    }
+  } else {
+    max_index = (regs->values[XE_GPU_REG_VGT_DRAW_INITIATOR] >> 16) - 1;
+  }
+  const uint32_t head[6] = {0x42564450u, this_draw, PdDrawLogFrame(),
+                            index_format, index_endian, index_bytes};
+  std::fwrite(head, 4, 6, file);
+  if (index_bytes) {
+    std::fwrite(index_data, 1, index_bytes, file);
+  }
+  uint32_t nbind = 0;
+  if (vertex_shader && vertex_shader->is_ucode_analyzed()) {
+    nbind = uint32_t(vertex_shader->vertex_bindings().size());
+  }
+  std::fwrite(&nbind, 4, 1, file);
+  for (uint32_t b = 0; b < nbind; b++) {
+    const auto& binding = vertex_shader->vertex_bindings()[b];
+    const auto fetch = regs->GetVertexFetch(binding.fetch_constant);
+    uint32_t words = (max_index + 1) * binding.stride_words;
+    if (words > fetch.size) {
+      words = fetch.size;
+    }
+    if (words > (1u << 18)) {
+      words = 1u << 18;
+    }
+    const uint32_t bhead[3] = {binding.fetch_constant, binding.stride_words,
+                               words};
+    std::fwrite(bhead, 4, 3, file);
+    if (words) {
+      std::fwrite(memory->TranslatePhysical(fetch.address << 2), 4, words,
+                  file);
+    }
+  }
+}
