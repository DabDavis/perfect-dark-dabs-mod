   // Type-3 packet.
   uint32_t opcode = (packet >> 8) & 0x7F;
@@ -763,6 +989,7 @@
     trace_writer_.WritePacketEnd();
     if (opcode == PM4_XE_SWAP) {
       PdDrawLogSwap();
