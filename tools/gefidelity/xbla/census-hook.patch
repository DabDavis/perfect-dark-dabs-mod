+	// The census: a body that keeps groups for heads the release never puts
+	// on it (a body of the remake's rows, with noskin groups) draws, under
+	// its own head file - the release's pairing - each noskin group in place
+	// of its node's, and neither the collar's filler nor its own neck
+	// (xblamesh.c: no headfit on the remake's own rig). A draw's "took" is
+	// what it gave to the groups drawn so; the rest is logged as "alt"
+	if (gebeanCensusOn() && beanCensusGroups && numnoskin > 0) {
+		u64 alt = 0;
+
+		for (s32 k = 0; k < 64; k++) {
+			if (noskinof[k] >= 0) {
+				alt |= 1ull << k;
+			}
+
+			if (fillof[k] >= 0) {
+				alt |= 1ull << fillof[k];
+			}
+
+			if (ownof[k] >= 0) {
+				alt |= 1ull << ownof[k];
+			}
+		}
+
+		for (s32 i = 0; i < bm.numdraws && i < BEAN_MAXDRAWS; i++) {
+			u32 drawn = 0;
+			u32 other = 0;
+
+			for (s32 g = 0; g < 64; g++) {
+				if (alt & (1ull << g)) {
+					other += beanCensusGroups[i][g];
+				} else {
+					drawn += beanCensusGroups[i][g];
+				}
+			}
+
+			if (other) {
+				sysLogPrintf(LOG_NOTE, "census: alt %p %x %u", (void *)&bm, bm.draws[i].pc, other);
