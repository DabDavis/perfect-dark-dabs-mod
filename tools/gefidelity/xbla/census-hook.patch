@@ -11462,6 +11544,7 @@ static u8 *gebeanBuildFirstPerson(s32 fp, s32 original, struct modeldef *modelde
 
 	for (s32 di = 0; di < bm.numdraws; di++) {
 		const struct beandraw *d = &bm.draws[di];
+		beanCensusCur = (struct beandraw *)d; // the census counts what this draw gives
 		struct beanvb vb;
 		u16 *tris;
 		s32 numtris;
@@ -11686,6 +11769,7 @@ static u8 *gebeanBuildFirstPerson(s32 fp, s32 original, struct modeldef *modelde
 		free(mappedmtx);
 		free(tris);
 	}
+	beanCensusCur = NULL;
 
 	if (bladepts) {
 		fpPlaced[fp].bladeset = headfitBladeFrame(bladepts, numbladepts, fpPlaced[fp].blade,
@@ -12875,6 +12959,7 @@ u8 *gebeanBuild(s32 row, s32 original, struct modeldef *modeldef, struct modelno
 
 	for (s32 di = 0; di < bm.numdraws; di++) {
 		const struct beandraw *d = &bm.draws[di];
+		beanCensusCur = (struct beandraw *)d; // the census counts what this draw gives
 		struct beanvb vb;
 		u16 *tris;
 		s32 numtris;
@@ -13568,6 +13653,7 @@ u8 *gebeanBuild(s32 row, s32 original, struct modeldef *modeldef, struct modelno
 		free(mapped);
 		free(tris);
 	}
+	beanCensusCur = NULL;
 	}
 
 	// Nodes that must draw nothing rather than keep their N64 geometry: a
@@ -14286,11 +14372,24 @@ s32 gebeanLevelTriangles(struct gebeanlevel *level,
 
 			fn(arg, tex, v);
 			count++;
+
+			if (gebeanCensusOn()) {
