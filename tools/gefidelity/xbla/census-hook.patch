+/*
+ * The HD draw census (tools/gefidelity/xbla/census.py): GEBEAN_CENSUS set logs
+ * every draw a model's stream gives the walk and how many triangles each build
+ * took from it, and xblamesh.c builds every registered model at its load.
+ * GEBEAN_CENSUS_SKIP=<source>@<pc in hex> leaves that one draw out of the walk:
+ * the census's planted fault, which its report must find. Off unless set.
+ */
+static s32 beanCensus = -1;
+static const char *beanCensusSkip;
+static struct beandraw *beanCensusCur;
+// and, while gebeanBuild() walks a character's draws, the triangles each draw
+// gave to each group, so a body that keeps groups for heads the release never
+// puts on it can count apart what it draws under its own head file
+static struct beandraw *beanCensusBase;
+static u16 (*beanCensusGroups)[64];
+
+s32 gebeanCensusOn(void)
+{
+	if (beanCensus < 0) {
+		beanCensus = getenv("GEBEAN_CENSUS") != NULL;
+		beanCensusSkip = getenv("GEBEAN_CENSUS_SKIP");
+	}
+
+	return beanCensus;
+}
+
+static s32 beanCensusSkips(const char *source, u32 pc)
+{
+	char want[96];
+
+	if (!gebeanCensusOn() || !beanCensusSkip) {
+		return 0;
+	}
+
+	snprintf(want, sizeof(want), "%s@%x", source, pc);
+
+	return strcmp(want, beanCensusSkip) == 0;
+}
