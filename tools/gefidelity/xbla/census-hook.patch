+				(void *)bm, source, keepparts, bm->numdraws, bm->numtex, path);
+
+		for (s32 i = 0; i < bm->numdraws; i++) {
+			const struct beandraw *d = &bm->draws[i];
+
+			sysLogPrintf(LOG_NOTE, "census: draw %p %x prim %u count %u piece %d section %d tex %u",
+					(void *)bm, d->pc, d->prim, d->count, d->piece, d->section, d->tex);
+		}
+	}
+
 	return 1;
 }
 
