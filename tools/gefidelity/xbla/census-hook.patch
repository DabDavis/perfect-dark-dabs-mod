-			if (part <= 1 || bm->keepparts) {
+			if ((part <= 1 || bm->keepparts) && !beanCensusSkips(bm->censussrc, pc)) {
 				struct beandraw *d = &bm->draws[bm->numdraws++];
 
+				d->pc = pc;
 				d->vb = vb;
 				d->tex = tex;
 				d->prim = gebeanBE32(st + pc + 4);
@@ -4755,8 +4793,33 @@ static s32 beanTriangles32(const struct beanmodel *bm, const struct beandraw *d,
 	return n;
 }
 
+static void beanCensusBuilt(const struct beanmodel *bm, const char *how)
+{
+	s32 any = 0;
+
+	if (!gebeanCensusOn() || !bm->draws) {
+		return;
+	}
+
+	for (s32 i = 0; i < bm->numdraws; i++) {
+		any |= bm->draws[i].emitted > 0;
+	}
+
+	sysLogPrintf(LOG_NOTE, "census: %s %p %s", any ? how : "unbuilt", (void *)bm, bm->censussrc);
+
+	for (s32 i = 0; any && i < bm->numdraws; i++) {
+		sysLogPrintf(LOG_NOTE, "census: took %p %x %u", (void *)bm, bm->draws[i].pc, bm->draws[i].emitted);
+	}
+}
+
 static void beanFree(struct beanmodel *bm)
 {
+	beanCensusBuilt(bm, "built");
+
+	if (bm->draws && beanCensusCur >= bm->draws && beanCensusCur < bm->draws + BEAN_MAXDRAWS) {
+		beanCensusCur = NULL;
+	}
+
 	caffClose(&bm->caff);
