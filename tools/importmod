# -- rzip / 1173 ------------------------------------------------------------

def is1173(buf, ofs=0):
    return len(buf) >= ofs + 5 and buf[ofs] == 0x11 and buf[ofs + 1] == 0x73


def inflate1173(buf, ofs=0):
    """Returns (inflated, consumed). The 5 byte header is 1173 then a 24 bit
    inflated length; the rest is raw deflate."""
    if not is1173(buf, ofs):
        raise ValueError('not 1173 compressed')
    obj = zlib.decompressobj(wbits=-15)
    out = obj.decompress(buf[ofs + 5:])
    out += obj.flush()
    return out, len(buf) - ofs - len(obj.unused_data)


def be32(buf, ofs):
    return int.from_bytes(buf[ofs:ofs + 4], 'big')


def be16(buf, ofs):
    return int.from_bytes(buf[ofs:ofs + 2], 'big')


def align16(n):
    return (n + 15) & ~15


# -- patch formats ----------------------------------------------------------

def apply_xdelta(rompath, patchpath, outpath):
    """xdelta3 patches in the wild use secondary compression - the two in this
    repo use static Huffman and lzma respectively - so shell out rather than
    carry a decoder for every compressor a mod author might have used."""
    if not shutil.which('xdelta3'):
        die('this is an xdelta patch and the xdelta3 binary was not found.\n'
            '       install it (debian/ubuntu: apt install xdelta3) or pass a\n'
            '       pre-patched ROM with --patched-rom instead.')
    cmd = ['xdelta3', '-d', '-f', '-s', rompath, patchpath, outpath]
    proc = subprocess.run(cmd, capture_output=True)
    if proc.returncode != 0:
        msg = proc.stderr.decode('utf-8', 'replace').strip()
        die('xdelta3 failed: %s\n       (is this patch built against a different base ROM?)' % msg)


def bps_varint(data, i):
    result = 0
    shift = 1
    while True:
        x = data[i]
        i += 1
        result += (x & 0x7f) * shift
        if x & 0x80:
            return result, i
        shift <<= 7
        result += shift


def apply_bps(rom, patch):
    if patch[:4] != b'BPS1':
        raise ValueError('not a BPS patch')
    if zlib.crc32(patch[:-4]) != int.from_bytes(patch[-4:], 'little'):
        die('BPS patch is corrupt (checksum mismatch).')

    i = 4
    srclen, i = bps_varint(patch, i)
    dstlen, i = bps_varint(patch, i)
    metalen, i = bps_varint(patch, i)
    i += metalen

    if srclen != len(rom):
        die('BPS patch expects a %u byte source ROM, got %u.' % (srclen, len(rom)))
    if zlib.crc32(rom) != int.from_bytes(patch[-12:-8], 'little'):
        die('BPS patch is for a different base ROM (source checksum mismatch).')

    out = bytearray(dstlen)
    end = len(patch) - 12
    outpos = srcpos = dstpos = 0

    while i < end:
        cmd, i = bps_varint(patch, i)
        action = cmd & 3
        length = (cmd >> 2) + 1
        if action == 0:  # SourceRead
            out[outpos:outpos + length] = rom[outpos:outpos + length]
            outpos += length
        elif action == 1:  # TargetRead
            out[outpos:outpos + length] = patch[i:i + length]
            i += length
            outpos += length
        else:  # SourceCopy / TargetCopy
            raw, i = bps_varint(patch, i)
            delta = (raw >> 1) * (-1 if raw & 1 else 1)
            if action == 2:
                srcpos += delta
                out[outpos:outpos + length] = rom[srcpos:srcpos + length]
                srcpos += length
                outpos += length
            else:
                dstpos += delta
                # may overlap itself, so copy a byte at a time
                for _ in range(length):
                    out[outpos] = out[dstpos]
                    outpos += 1
                    dstpos += 1

    out = bytes(out)
    if zlib.crc32(out) != int.from_bytes(patch[-8:-4], 'little'):
        die('BPS patch applied but the result checksum does not match.')

    return out


def apply_ips(rom, patch):
    if patch[:5] != b'PATCH':
        raise ValueError('not an IPS patch')

    out = bytearray(rom)
    i = 5
    truncated = False

    while i < len(patch):
        if patch[i:i + 3] == b'EOF':
            # a 3 byte truncation length may follow
            if len(patch) - i == 6:
                del out[int.from_bytes(patch[i + 3:i + 6], 'big'):]
            break
        ofs = int.from_bytes(patch[i:i + 3], 'big')
        size = int.from_bytes(patch[i + 3:i + 5], 'big')
        i += 5
        if size:
            out[ofs:ofs + size] = patch[i:i + size]
            i += size
        else:
            rle = int.from_bytes(patch[i:i + 2], 'big')
            out[ofs:ofs + rle] = bytes([patch[i + 2]]) * rle
            i += 3
        if ofs + max(size, 1) >= 0x1000000:
            truncated = True

    if truncated:
        log('warning: IPS offsets are 24 bit, so nothing past 16MB of the ROM')
        log('         can be patched. Parts of this mod are almost certainly missing.')

    return bytes(out)


def apply_patch(rompath, rom, patchpath, workdir):
    with open(patchpath, 'rb') as fd:
        head = fd.read(8)

    if head[:4] == b'\xd6\xc3\xc4\x00':
        outpath = os.path.join(workdir, 'patched.z64')
        apply_xdelta(rompath, patchpath, outpath)
        with open(outpath, 'rb') as fd:
            return fd.read(), 'xdelta'

    with open(patchpath, 'rb') as fd:
        patch = fd.read()

    if head[:4] == b'BPS1':
        return apply_bps(rom, patch), 'bps'
    if head[:5] == b'PATCH':
        return apply_ips(rom, patch), 'ips'

    die('unrecognised patch format (not xdelta, BPS or IPS).')


# -- ROM parsing ------------------------------------------------------------

def identify_rom(rom):
    for romid, info in ROMS.items():
        if rom[0x20:0x20 + len(info['title'])] == info['title'].encode() \
                and rom[0x3b:0x3f] == info['code'].encode():
            return romid
    return None


def find_data_segment(rom, expected):
    """The compressed data segment holds the file table. It sits at a fixed
    offset in the stock ROM, but a mod that rebuilds it moves it - so fall back
    to hunting for the 1173 blob that actually contains a file table.

    Returns (rom offset, inflated segment, file table offset)."""
    got = try_data_segment(rom, expected)
    if got:
        return (expected,) + got

    i = 0
    while True:
        i = rom.find(b'\x11\x73', i, DATA_SEG_SEARCH_END)
        if i < 0:
            return None, None, None
        length = int.from_bytes(rom[i + 2:i + 5], 'big')
        if 0x10000 < length < 0x400000:
            got = try_data_segment(rom, i)
            if got:
                return (i,) + got
        i += 1


def try_data_segment(rom, ofs):
    """Inflate a candidate and see whether it holds a file table."""
    if not is1173(rom, ofs):
        return None
    try:
        data, _ = inflate1173(rom, ofs)
    except zlib.error:
        return None
    if len(data) < 0x10000:
        return None
    filesofs = find_file_table(rom, data)
    if filesofs is None:
        return None
    return data, filesofs


# The stock ROM's file names, once it has been read. The game never reads the
# name table, so an old mod tool could drop it (GE Gun Name Display, 2009,
# leaves zeros where it was); the file ids still mean the same files, so the
# stock names stand in for them.
stock_names = None
names_missing_noted = False


def names_missing(count):
    """Can a file table of this many entries do without its name table?"""
    return stock_names is not None and abs(count - len(stock_names)) <= 1


def find_file_table(rom, dataseg):
    """The file table is a run of ascending big endian ROM offsets whose last
    entry points at the name table. Mods move it, so look for that shape rather
    than trusting ROMDATA_FILES_OFS."""
    runstart = None
    prev = 0
    i = 0

    while i + 4 <= len(dataseg):
        v = be32(dataseg, i)
        if 0x1000 <= v <= len(rom) and v >= prev:
            if runstart is None:
                runstart = i
            prev = v
        else:
            if runstart is not None and (i - runstart) // 4 > MIN_FILES \
                    and (read_name_table(rom, prev) is not None
                         or names_missing((i - runstart) // 4)):
                # step back onto the leading zero entry so that file numbers and
                # name numbers line up, the way romdataInitFiles() indexes them
                if runstart >= 4 and be32(dataseg, runstart - 4) == 0:
                    return runstart - 4
                return runstart
            runstart = None
            prev = 0
        i += 4

    return None


def read_name_table(rom, ofs):
    """Names are a zero terminated array of offsets relative to the table,
    followed by the strings. Returns None if this is not one.

    Anything unreadable ends the table rather than rejecting it: mods leave
    junk in the spare slots past their last real file, and the entries before
    it are still good.
    """
    if ofs + 8 > len(rom) or be32(rom, ofs) != 0:
        return None

    names = ['']
    prev = 0
    i = ofs + 4

    while i + 4 <= len(rom) and len(names) <= MAX_FILES:
        rel = be32(rom, i)
        if rel == 0 or rel < prev or ofs + rel >= len(rom):
            break
        end = rom.find(b'\0', ofs + rel, ofs + rel + 256)
        if end < 0:
            break
        name = rom[ofs + rel:end]
        if not all(32 <= c < 127 for c in name):
            break
        names.append(name.decode('ascii'))
        prev = rel
        i += 4

    return names if len(names) > MIN_FILES else None


def read_file_table(rom, dataseg, filesofs):
    """Returns (offsets, names). Mirrors romdataInitFiles(): the table is a run
    of ascending big endian ROM offsets, and the last of them points at the name
    table rather than a file. The first entry is the unused slot 0.

    romdataInitFiles() stops at a zero entry; stop at anything that is not a
    plausible next offset, because mods leave other junk past the end.
    """
    offsets = [be32(dataseg, filesofs)]
    i = filesofs + 4

    while i + 4 <= len(dataseg):
        ofs = be32(dataseg, i)
        if ofs < 0x1000 or ofs < offsets[-1] or ofs > len(rom):
            break
        offsets.append(ofs)
        i += 4

    if len(offsets) < MIN_FILES:
        return None, None

    names = read_name_table(rom, offsets[-1])
    if names is None and names_missing(len(offsets)):
        global names_missing_noted
        if not names_missing_noted:
            log('note:    this ROM has no file name table (an old mod tool dropped it); using the')
            log('         stock ROM\'s names, since its %u file ids line up with the stock %u'
                % (len(offsets) - 2, len(stock_names) - 1))
            log()
            names_missing_noted = True
        names = stock_names
    if names is None:
        return None, None

    return offsets, names


def read_files(rom, romid, label):
    """Every asset in the ROM, by its ROM filename."""
    dataofs, dataseg, filesofs = find_data_segment(rom, ROMS[romid]['data'])
    if dataofs is None:
        die('could not find a file table in the %s ROM.\n'
            '       Either it is not a Perfect Dark ROM or the mod rebuilt the data\n'
            '       segment in a shape this tool does not recognise.' % label)

    offsets, names = read_file_table(rom, dataseg, filesofs)
    if offsets is None:
        die('could not read the file table in the %s ROM.' % label)

    if label == 'stock':
        global stock_names
        stock_names = names

    files = {}
    # index 0 is unused, and the final offset is the name table
    for n in range(1, len(offsets) - 1):
        if n >= len(names):
            break
        name = names[n]
        if not name:
            continue  # unnamed spare slot
        if name.startswith('/') or '..' in name.split('/'):
            log('warning: skipping file %d with suspicious name %r' % (n, name))
            continue
        files[name] = trim_padding(rom[offsets[n]:offsets[n + 1]])

    return files, dataofs, filesofs


def trim_padding(content):
    """Files are padded to an alignment in the ROM. Drop whatever the deflate
    stream did not consume so identical files compare equal."""
    if is1173(content):
        try:
            _, consumed = inflate1173(content)
            return content[:consumed]
        except zlib.error:
            pass
    return content


def check_pads(d):
    """See preprocessPadsFile(): a 20 byte header, then one u16 offset per pad."""
    if len(d) < 24:
        return 'too short for a pads file'
    npads, ncovers = be32(d, 0), be32(d, 4)
    if npads > 20000 or ncovers > 20000:
        return 'implausible pad/cover counts (%d/%d)' % (npads, ncovers)
    for ofs in (be32(d, 8), be32(d, 12), be32(d, 16)):
        # a section may be empty, and then points at the end of the file
        if not 0 < ofs <= len(d):
            return 'header pointer %#x is outside the file' % ofs
    first = 20 + npads * 2
    if first > len(d):
        return 'offset table does not fit'
    for i in range(npads):
        ofs = be16(d, 20 + i * 2)
        if not first <= ofs < len(d):
            return 'the pad offset table is not the stock 16 bit one'
    return None


def check_setup(d):
    """See convertSetup(): eight pointers, of which four are always used."""
    if len(d) < 32:
        return 'too short for a setup file'
    for n, field in ((3, 'intro'), (4, 'props'), (5, 'paths'), (6, 'ailists')):
        ofs = be32(d, n * 4)
        if not 0 < ofs <= len(d):
            return '%s pointer %#x is outside the file' % (field, ofs)
    if len(d) < 0x80:
        # Every section is an end marker: a Combat Simulator setup with no
        # spawn pads. The stock ROM has these for every stage that is not an
        # arena, and a mod rewriting them (PD11 GE Weapons) changes nothing
        # the port could use - booting a match on one loops forever looking
        # for somewhere to spawn, with the stock file just the same.
        return 'stub setup (%u bytes, no objects); not a Combat Simulator arena' % len(d)
    return None


# model node type -> (rodata kind, rodata size), as filemodel.c has them
MODEL_NODE_RODATA = {
    0x01: ('chrinfo', 0x0c), 0x02: ('position', 0x18), 0x04: ('gundl', 0x14),
    0x08: ('distance', 0x10), 0x09: ('reorder', 0x24), 0x0a: ('bbox', 0x1c),
    0x0c: ('chrgunfire', 0x28), 0x11: ('type11', 0x20), 0x12: ('toggle', 0x08),
    0x15: ('positionheld', 0x14), 0x16: ('stargunfire', 0x10), 0x17: ('headspot', 0x04),
    0x18: ('dl', 0x18), 0x19: ('type19', 0x04),
}

class BadModel(Exception):
    pass

def walk_model(d):
    n = len(d)
    if n < 0x1c:
        raise BadModel('too short for a model file (%d bytes)' % n)

    def ptr(v, what):
        """A segmented pointer into the file, as an offset; 0 stays 0."""
        if v == 0:
            return 0
        if (v >> 24) != 0x05:
            raise BadModel('%s pointer %08x is not in segment 5' % (what, v))
        o = v & 0xffffff
        if o >= n:
            raise BadModel('%s pointer %08x is past the end of the file (%d bytes)' % (what, v, n))
        return o

    def fits(o, size, what):
        if o + size > n:
            raise BadModel('%s at %#x runs past the end of the file' % (what, o))

    rootnode = ptr(be32(d, 0), 'root node')
    parts = ptr(be32(d, 8), 'parts')
    numparts = be16(d, 12)
    nummatrices = be16(d, 14)
    rwdatalen = be16(d, 20)
    numtexconfigs = be16(d, 22)
    texconfigs = ptr(be32(d, 24), 'texture configs')
    if numparts < 0 or numparts > 512:
        raise BadModel('%d parts' % numparts)
    if numtexconfigs > 512:
        raise BadModel('%d texture configs' % numtexconfigs)
    if numtexconfigs and texconfigs:
        fits(texconfigs, numtexconfigs * 12, 'texture configs')
    if parts:
        fits(parts, numparts * 6, 'parts table')

    nodes = {}
    gdls = set()
    stats = { 'nodes': 0, 'gdls': 0, 'texdata': 0 }

    def node(o, what):
        if o == 0 or o in nodes:
            return
        fits(o, 0x18, what + ' node')
        t = be16(d, o)
        kind = t & 0xff
        rodata = be32(d, o + 4)
        nodes[o] = kind
        stats['nodes'] += 1
        if kind not in MODEL_NODE_RODATA:
            if rodata:
                raise BadModel('node at %#x has type %#x, which the port has no rodata for, yet points at rodata' % (o, t))
            if kind > 0x19:
                raise BadModel('node at %#x has type %#x, past the port\'s table' % (o, t))
        else:
            name, size = MODEL_NODE_RODATA[kind]
            r = ptr(rodata, '%s rodata' % name)
            if r:
                fits(r, size, name + ' rodata')
                rodatas.append((r, kind))
        for f, w in ((8, 'parent'), (12, 'next'), (16, 'prev'), (20, 'child')):
            node(ptr(be32(d, o + f), w), w)

    def gdl(o, what):
        if o == 0 or o in gdls:
            return
        gdls.add(o)
        stats['gdls'] += 1
        p = o
        while True:
            if p + 8 > n:
                raise BadModel('%s display list at %#x runs off the file without G_ENDDL' % (what, o))
            op = d[p]
            if op == 0xb8:
                break
            if op == 0x06:
                # G_DL: branch or call to another list in the file
                gdl(ptr(be32(d, p + 4), 'G_DL target'), what)
            p += 8

    rodatas = []
    node(rootnode, 'root')
    if parts:
        for i in range(numparts):
            node(ptr(be32(d, parts + i * 4), 'part %d' % i), 'part %d' % i)

    i = 0
    while i < len(rodatas):
        r, kind = rodatas[i]
        i += 1
        name = MODEL_NODE_RODATA[kind][0]
        if name == 'gundl':
            gdl(ptr(be32(d, r), 'opaque'), 'gundl')
            gdl(ptr(be32(d, r + 4), 'translucent'), 'gundl')
            v = ptr(be32(d, r + 12), 'gundl vertices')
            fits(v, be16(d, r + 16) * 12, 'gundl vertices')
        elif name == 'dl':
            gdl(ptr(be32(d, r), 'opaque'), 'dl')
            gdl(ptr(be32(d, r + 4), 'translucent'), 'dl')
            ptr(be32(d, r + 8), 'dl colours')
            v = ptr(be32(d, r + 12), 'dl vertices')
            fits(v, be16(d, r + 16) * 12, 'dl vertices')
        elif name == 'stargunfire':
            v = ptr(be32(d, r + 4), 'stargunfire vertices')
            fits(v, be32(d, r) * 4 * 12, 'stargunfire vertices')
            gdl(ptr(be32(d, r + 8), 'stargunfire'), 'stargunfire')
        elif name == 'distance':
            node(ptr(be32(d, r + 8), 'distance target'), 'distance target')
        elif name == 'toggle':
            node(ptr(be32(d, r), 'toggle target'), 'toggle target')
        elif name == 'reorder':
            node(ptr(be32(d, r + 24), 'reorder node'), 'reorder node')
            node(ptr(be32(d, r + 28), 'reorder node'), 'reorder node')
        elif name == 'chrgunfire':
            t = ptr(be32(d, r + 24), 'chrgunfire texture')
            fits(t, 12, 'chrgunfire texture config')
        elif name == 'type19':
            fits(r, 4 + be32(d, r) * 12, 'type19 vertices')

    for i in range(numtexconfigs):
        o = texconfigs + i * 12
        v = be32(d, o)
        if (v >> 24) == 0x05:
            ptr(v, 'texture data')
            stats['texdata'] += 1
        elif v >= 0x10000:
            raise BadModel('texture config %d refers to texture %#x' % (i, v))

    return stats


def check_model(d):
    """See port/src/preprocess/filemodel.c: populateMarkers() follows every
    pointer in the file - nodes, rodata, display lists, texture configs -
    with no bounds check, and convertContent() then reads at each one. A
    model built for a mod's own code can point outside the file (Spooky Dark's
    CMP150 has its muzzle flash texture at 0x0dc42e88, another segment) and
    the port crashes reading it. This walks the same graph and says where it
    leaves the file."""
    try:
        walk_model(d)
    except BadModel as e:
        return str(e)
    return None


def check_file(name, content):
    """Is this file in the format the port's preprocessors expect? A mod built
    for its own modified game code can ship assets in a format only that code
    reads, and the port will crash on them rather than reject them."""
    data = content
    if is1173(content):
        try:
            data, _ = inflate1173(content)
        except zlib.error:
            return 'not decompressible'

    base = name.rsplit('/', 1)[-1]
    if base.endswith('padsZ'):
        return check_pads(data)
    if base.startswith('U'):
        return check_setup(data)
    if base.startswith('bg_') and base.endswith('.seg'):
        return check_bg(data)
    if base[0] in 'CPG' and base.endswith('Z'):
        # chr bodies and heads, props, guns and hands: one converter
        return check_model(data)
    return None


def check_bg(d):
    """A background file starts with the inflated size of its primary
    section (rooms, portals, lights), then that section 1173-compressed. A
    mod that drops a stage to make room leaves a stub in its place: Aviation
    Trilogy's Air Force One is 124 bytes of primary section, which the port's
    bg preprocessor fatals on ("overflow when trying to preprocess a bg
    file") rather than refusing."""
    if len(d) < 16:
        return 'too short for a background file'
    inflated = be32(d, 0)
    if inflated < 0x100:
        return 'stub background (%u byte primary section); the mod removed this stage' % inflated
    if not is1173(d, 12):
        return 'primary section is not 1173-compressed'
    return None


def content_equal(a, b):
    if a == b:
        return True
    # different compressed bytes can still be the same asset
    if is1173(a) and is1173(b):
        try:
            return inflate1173(a)[0] == inflate1173(b)[0]
        except zlib.error:
            return False
    return False


# -- segments ---------------------------------------------------------------

ALBANK_MAGIC = b'\x42\x31\x00\x01'  # ALBankFile revision "B1", one bank list


def albank_extents(rom, ofs, limit):
    """Walk an ALBankFile the way preprocessALBankFile() does and return
    (bytes it occupies, bytes of sample data it references in its .tbl).

    Both come out a little short of the real segment sizes because the ROM pads
    them, so they are used as lower bounds: the .tbl's true start is measured
    backwards from the segment that follows it.
    """
    seen = set()
    ctlend = 0
    tblend = 0

    def mark(o, n):
        nonlocal ctlend
        if o < 0 or o + n > limit:
            raise ValueError('offset out of range')
        ctlend = max(ctlend, o + n)

    def u16(o):
        mark(o, 2)
        return be16(rom, ofs + o)

    def u32(o):
        mark(o, 4)
        return be32(rom, ofs + o)

    nbanks = u16(2)
    if not 0 < nbanks < 256:
        raise ValueError('implausible bank count')
    mark(0, 4 + 4 * nbanks)

    for i in range(nbanks):
        bank = u32(4 + 4 * i)
        if bank in seen:
            continue
        seen.add(bank)
        ninst = u16(bank)
        mark(bank, 12 + 4 * ninst)
        insts = [u32(bank + 8)] if u32(bank + 8) else []
        insts += [u32(bank + 12 + 4 * k) for k in range(ninst)]

        for inst in insts:
            if not inst or inst in seen:
                continue
            seen.add(inst)
            nsnd = u16(inst + 14)
            mark(inst, 16 + 4 * nsnd)

            for k in range(nsnd):
                sound = u32(inst + 16 + 4 * k)
                if not sound or sound in seen:
                    continue
                seen.add(sound)
                mark(sound, 16)
                env, keymap, wave = u32(sound), u32(sound + 4), u32(sound + 8)
                if env:
                    mark(env, 14)
                if keymap:
                    mark(keymap, 6)
                if not wave or wave in seen:
                    continue
                seen.add(wave)
                mark(wave, 20)
                tblend = max(tblend, u32(wave) + u32(wave + 4))
                if rom[ofs + wave + 8] == 0:  # AL_ADPCM_WAVE
                    loop, book = u32(wave + 12), u32(wave + 16)
                    if loop:
                        mark(loop, 44)
                    if book:
                        mark(book, 8 + 16 * u32(book) * u32(book + 4))
                else:
                    if u32(wave + 12):
                        mark(u32(wave + 12), 12)

    return align16(ctlend), align16(tblend)


def albank_waves(rom, ofs, limit):
    """(base, len) of every wave an ALBankFile references, in .tbl terms."""
    seen = set()
    out = []

    def u16(o):
        if o < 0 or o + 2 > limit:
            raise ValueError('offset out of range')
        return be16(rom, ofs + o)

    def u32(o):
        if o < 0 or o + 4 > limit:
            raise ValueError('offset out of range')
        return be32(rom, ofs + o)

    nbanks = u16(2)
    if not 0 < nbanks < 256:
        raise ValueError('implausible bank count')
    for i in range(nbanks):
        bank = u32(4 + 4 * i)
        if bank in seen:
            continue
        seen.add(bank)
        ninst = u16(bank)
        insts = [u32(bank + 8)] if u32(bank + 8) else []
        insts += [u32(bank + 12 + 4 * k) for k in range(ninst)]
        for inst in insts:
            if not inst or inst in seen:
                continue
            seen.add(inst)
            for k in range(u16(inst + 14)):
                sound = u32(inst + 16 + 4 * k)
                if not sound or sound in seen:
                    continue
                seen.add(sound)
                wave = u32(sound + 8)
                if not wave or wave in seen:
                    continue
                seen.add(wave)
                out.append((u32(wave), u32(wave + 4)))
    return out


def tbl_start_by_samples(stock, mod, stockctl, stocktbl, modctl, lo, hi):
    """Where a mod's .tbl starts, from the stock samples it kept.

    Measuring the table back from the segment after it assumes it ends where
    its last referenced sample does - and GE-X's does not: its bank file drops
    waves and leaves their data in the table, 81KB of it at the end, so the
    measured start landed 81KB late and every sample played as noise. A
    kept sample's data is at the same offset from the true start in both
    ROMs, so each one found in the patched ROM votes for a start, and a mod
    that kept any of the stock sounds elects it by hundreds to one.

    Returns (start, votes), or (None, 0)."""
    try:
        stockwaves = albank_waves(stock, stockctl, hi - stockctl)
        modwaves = albank_waves(mod, modctl, hi - modctl)
    except (ValueError, IndexError):
        return None, 0

    bylen = {}
    for base, length in modwaves:
        bylen.setdefault(length, []).append(base)

    votes = {}
    for base, length in stockwaves:
        if length < 64 or length not in bylen:
            continue
        at = mod.find(stock[stocktbl + base:stocktbl + base + 48], lo, hi)
        if at < 0:
            continue
        for modbase in bylen[length]:
            start = at - modbase
            if lo <= start < hi:
                votes[start] = votes.get(start, 0) + 1

    if not votes:
        return None, 0
    ranked = sorted(votes.items(), key=lambda kv: -kv[1])
    start, n = ranked[0]
    second = ranked[1][1] if len(ranked) > 1 else 0
    # one sample matching by chance is one vote, and samples of one length
    # spread a hit over several starts; the table is the one far ahead
    if n < 4 or n < second * 3:
        return None, 0
    return start, n


def find_albankfile(rom, near, span=0x400000):
    """sfxctl and seqctl both start with the ALBankFile revision word."""
    for start, end in ((max(0, near - span), near + span), (0, len(rom))):
        at = rom.find(ALBANK_MAGIC, start, end)
        while at >= 0:
            try:
                albank_extents(rom, at, min(0x800000, len(rom) - at))
                return at
            except (ValueError, IndexError):
                pass
            at = rom.find(ALBANK_MAGIC, at + 1, end)
    return None


def seqtable_extent(rom, ofs):
    """The sequences segment is a count, then {romaddr, binlen, ziplen} entries
    at offset 4, with the sequence data behind them. romaddr is relative to the
    segment itself (see sndInit), so the table also gives its total size."""
    count = be16(rom, ofs)
    if not 0 < count < 0x400:
        raise ValueError('implausible sequence count')

    end = 4 + count * 8
    prev = end
    if be32(rom, ofs + 4) != end:
        raise ValueError('sequence data does not follow the table')
    for i in range(count):
        addr = be32(rom, ofs + 4 + i * 8)
        binlen = be16(rom, ofs + 8 + i * 8)
        ziplen = be16(rom, ofs + 10 + i * 8)
        if addr < prev or not 0 < ziplen <= binlen or addr + ziplen > 0x400000:
            raise ValueError('bad sequence entry %d' % i)
        prev = end = addr + ziplen

    return align16(end)


def find_seqtable(rom, lo, hi):
    for at in range(max(0, lo), min(len(rom) - 16, hi), 4):
        try:
            seqtable_extent(rom, at)
            return at
        except (ValueError, IndexError):
            pass
    return None


def find_texture_table(rom, near, count, span=0x400000):
    """textureslist is an array of 8 byte entries whose second, third and fourth
    bytes are an ascending offset into texturesdata, starting at zero."""
    def dataofs(at, i):
        return int.from_bytes(rom[at + i * 8 + 1:at + i * 8 + 4], 'big')

    def valid(at):
        if dataofs(at, 0) != 0:
            return False
        prev = 0
        for i in range(1, min(count, 256)):
            ofs = dataofs(at, i)
            if ofs < prev:
                return False
            # the second word of each entry is the runtime pointer, zero in the
            # ROM. The file name table is ascending offsets too, but packed
            # (Mr. X Stalker's sat where this looked, and its 2.7 MB "texture
            # list" put a garbage texture at every index).
            if rom[at + i * 8 + 4:at + i * 8 + 8] != b'\0\0\0\0':
                return False
            prev = ofs
        return prev > 0

    for at in range(max(0, near - span), min(len(rom) - count * 8, near + span), 4):
        if valid(at):
            return at
    return None


def stock_segments(romid):
    """The port's segment table for this ROM, sorted by offset, with each
    segment's stock size resolved the way romdataInitSegment() resolves it."""
    col = ROMID_COLUMN[romid]
    segs = [(name, size, offsets[col]) for (name, size, *offsets) in SEGMENTS if offsets[col]]
    segs.sort(key=lambda s: s[2])

    out = []
    for n, (name, size, ofs) in enumerate(segs):
        if not size:
            size = (segs[n + 1][2] if n + 1 < len(segs) else ROM_SIZE) - ofs
        out.append({ 'name': name, 'ofs': ofs, 'size': size })
    return out


def locate_segment(stock, mod, seg, hint):
    """Find where a segment moved to. Its bytes are copied verbatim by the patch
    wherever the mod did not touch it, so an exact match pins it down; a mod
    that rewrote the segment has to be found some other way.

    A short match is tried first, because a mod that edited a segment may have
    left only its first bytes alone. It is lengthened only when it turns out to
    match in several places, which is what a featureless start does - fonttahoma
    opens with a long run of zeroes.
    """
    at = None

    for length in (FINGERPRINT_LEN, FINGERPRINT_LEN * 16, FINGERPRINT_MAX):
        fp = stock[seg['ofs']:seg['ofs'] + min(length, seg['size'])]
        if len(fp) < 16:
            return None, 'too small to fingerprint'

        # try the shift the previous segment used, then no shift at all
        for cand in (seg['ofs'] + hint, seg['ofs']):
            if cand >= 0 and mod[cand:cand + len(fp)] == fp:
                return cand, None

        near = max(0, seg['ofs'] - 0x200000)
        at = mod.find(fp, near, seg['ofs'] + 0x200000)
        if at < 0:
            at = mod.find(fp)
        if at < 0:
            return None, 'not found'
        if mod.find(fp, at + 1) < 0:
            return at, None
        if len(fp) >= seg['size']:
            break

    return at, 'ambiguous'


def match_segments(stock, mod, romid):
    """Work out where each segment ended up in the patched ROM, and how big it
    is there.

    Fingerprinting finds anything the mod left alone. For what it rewrote,
    the segments that describe themselves - the two audio bank files, the
    sequence table, the texture table - can be found by their structure, and
    those in turn pin down their neighbours: a .tbl segment's true start is its
    following segment's start minus the sample bytes its .ctl accounts for.
    """
    segs = stock_segments(romid)
    byname = { s['name']: s for s in segs }
    hint = 0

    for seg in segs:
        at, note = locate_segment(stock, mod, seg, hint)
        seg['modofs'] = at
        seg['note'] = note
        if at is not None and note != 'ambiguous':
            hint = at - seg['ofs']

    locate_by_code(stock, mod, romid, segs)
    locate_structurally(stock, mod, byname)
    locate_by_adjacency(segs)

    # anything still missing moved with its neighbour, as far as we know
    hint = 0
    for seg in segs:
        if seg['modofs'] is None:
            seg['modofs'] = seg['ofs'] + hint
            seg['assumed'] = True
        else:
            hint = seg['modofs'] - seg['ofs']

    size_segments(segs)

    return segs


# The lib segment: a 1173 blob at a fixed offset, holding the code that reaches
# the audio banks, the sequences and the copyright segment.
LIB_OFS = 0x3050


def locate_by_code(stock, mod, romid, segs):
    """Where the mod's own code says its segments are.

    The game reaches every segment through a lui/addiu pair holding its ROM
    offset - the audio banks, the sequences and the copyright from the lib
    segment, the two texture segments from the game binary (texinit.c reads
    the list from `_textureslistSegmentRomStart` to `..RomEnd`, and
    texdecompress.c adds each texture's offset to `_texturesdataSegmentRomStart`).
    A mod tool that moves a segment rewrites those numbers, so a mod whose
    code is patched in place tells us exactly where everything went - which
    the structural search could not for Mr. X Stalker, Kakariko Village, the
    Mario Characters and Spooky Dark: their texture lists start at 2-byte
    alignment with junk in the pointer words, and the file name table looked
    more like a texture table than they did.
    """
    blobs = []

    if is1173(stock, LIB_OFS) and is1173(mod, LIB_OFS):
        try:
            stocklib, _ = inflate1173(stock, LIB_OFS)
            modlib, _ = inflate1173(mod, LIB_OFS)
            if len(stocklib) == len(modlib):
                blobs.append(('lib', stocklib, modlib))
        except zlib.error:
            pass

    try:
        mcd = load_modcodediff()
        stocktab = mcd.find_game_table(stock, mcd.GAME_TABLE.get(romid))
        modtab = mcd.find_game_table(mod, mcd.GAME_TABLE.get(romid))
        if stocktab and modtab:
            stockgame = mcd.extract_game(stock, stocktab)
            modgame = mcd.extract_game(mod, modtab)
            if len(stockgame) == len(modgame) and stockgame:
                blobs.append(('game', stockgame, modgame))
    except (OSError, ImportError, zlib.error):
        pass

    if not blobs:
        return

    pairs = [(name, address_pairs(a), address_pairs(b)) for name, a, b in blobs]

    def follow(value, only=None):
        votes = {}
        for name, sp, mp in pairs:
            if only and name != only:
                continue
            got, n = follow_table(sp, mp, value, 1)
            if got is not None:
                votes[got] = votes.get(got, 0) + n
        if not votes:
            return None, 0
        return max(votes.items(), key=lambda kv: kv[1])

    for seg in segs:
        got, n = follow(seg['ofs'])
        if got is None or got >= len(mod):
            continue
        if got == seg['ofs'] and seg['modofs'] != got \
                and mod[got:got + 64] != stock[got:got + 64]:
            # The code still says the stock offset, but the stock bytes are
            # not there: a reference the mod tool did not know to update. The
            # NTSC game never draws the Japanese fonts, and Suburb's tool left
            # their pointers alone while moving the fonts 300 KB down.
            continue
        if seg['modofs'] is not None and seg['modofs'] != got and seg.get('note') != 'ambiguous':
            log('note:    %s fingerprints at %08x but the mod\'s code reads it from %08x; using the code'
                % (seg['name'], seg['modofs'], got))
        seg['modofs'] = got
        seg['note'] = None
        seg['found'] = 'code (%d reference%s)' % (n, '' if n == 1 else 's')

    # texinit.c measures the list from its start to its end, and the mod's
    # code has both: that is the list's size, whatever follows it.
    for seg in segs:
        if seg['name'] == 'textureslist' and seg['modofs'] is not None:
            end, _ = follow(seg['ofs'] + seg['size'], only='game')
            if end is not None and seg['modofs'] < end <= len(mod):
                seg['modsize'] = end - seg['modofs']


def locate_structurally(stock, mod, byname):
    """Find the self-describing segments, then derive their neighbours."""
    def seg(name):
        return byname.get(name)

    def near(s):
        return s['modofs'] if s['modofs'] is not None else s['ofs']

    for name in ('sfxctl', 'seqctl'):
        s = seg(name)
        if s and s['modofs'] is None:
            s['modofs'] = find_albankfile(mod, near(s))
            if s['modofs'] is not None:
                s['found'] = 'ALBankFile header'

    s = seg('sequences')
    if s and s['modofs'] is None:
        # it follows seqctl and seqtbl, so start looking past the bank file
        lo = seg('seqctl')['modofs'] if seg('seqctl') and seg('seqctl')['modofs'] is not None else near(s) - 0x400000
        s['modofs'] = find_seqtable(mod, lo + 0x1000, lo + 0x800000)
        if s['modofs'] is not None:
            s['found'] = 'sequence table'
    if s and s['modofs'] is not None:
        try:
            s['modsize'] = seqtable_extent(mod, s['modofs'])
        except (ValueError, IndexError):
            pass

    # a .tbl holds nothing but samples. A fingerprint pins it; failing that,
    # the stock samples the mod kept say where it starts (see
    # tbl_start_by_samples); failing that, measure it back from the segment
    # after it using the byte count its .ctl accounts for
    for ctlname, tblname, nextname in (('sfxctl', 'sfxtbl', 'seqctl'),
                                       ('seqctl', 'seqtbl', 'sequences')):
        ctl, tbl, nxt = seg(ctlname), seg(tblname), seg(nextname)
        if not (ctl and tbl and nxt) or ctl['modofs'] is None or nxt['modofs'] is None:
            continue
        if tbl['modofs'] is not None and tbl.get('note') != 'ambiguous':
            ctl['modsize'] = tbl['modofs'] - ctl['modofs']
            tbl['modsize'] = nxt['modofs'] - tbl['modofs']
            continue
        try:
            ctlsize, tblsize = albank_extents(mod, ctl['modofs'], nxt['modofs'] - ctl['modofs'])
        except (ValueError, IndexError):
            continue
        start, votes = tbl_start_by_samples(stock, mod, ctl['ofs'], tbl['ofs'], ctl['modofs'],
                                            ctl['modofs'] + ctlsize, nxt['modofs'])
        if start is not None:
            tbl['found'] = '%d kept samples' % votes
            tbl['modofs'], tbl['modsize'] = start, nxt['modofs'] - start
        else:
            start = nxt['modofs'] - tblsize
            if start <= ctl['modofs']:
                continue
            tbl['found'] = '%s wave table sizes' % ctlname
            tbl['modofs'], tbl['modsize'] = start, tblsize
        ctl['modsize'] = start - ctl['modofs']

    tl, td, cp = seg('textureslist'), seg('texturesdata'), seg('copyright')
    if tl and tl['modofs'] is None:
        tl['modofs'] = find_texture_table(mod, near(tl), tl['size'] // 8)
        if tl['modofs'] is not None:
            tl['found'] = 'texture table'
    if tl and tl['modofs'] is not None and td and td['modofs'] is None:
        # the last entry's offset is the length of the data it indexes, and the
        # table sits directly behind that data
        count = tl['size'] // 8
        last = int.from_bytes(mod[tl['modofs'] + (count - 1) * 8 + 1:tl['modofs'] + (count - 1) * 8 + 4], 'big')
        td['modofs'], td['modsize'] = tl['modofs'] - align16(last), align16(last)
        td['found'] = 'texture table offsets'
    if tl and tl['modofs'] is not None and cp and cp['modofs'] is None:
        # the copyright segment is a 1173 blob just past the texture table
        at = mod.find(b'\x11\x73', tl['modofs'] + tl['size'] - 64, tl['modofs'] + tl['size'] + 0x1000)
        if at >= 0:
            cp['modofs'] = at
            cp['found'] = '1173 header after the texture table'
            tl['modsize'] = at - tl['modofs']


def locate_by_adjacency(segs):
    """Place what is left from a neighbour that was found.

    Two segments that touch in the stock ROM still touch in the patched one, so
    a segment sitting directly against one that was found is only as unknown as
    its own length - and the fixed-size tables (mpconfigs, the mp strings, the
    firing range) do not change length, because the port and the game both read
    them at a fixed size.
    """
    for _ in range(len(segs)):
        for n, seg in enumerate(segs):
            if seg['modofs'] is not None:
                continue
            after = segs[n + 1] if n + 1 < len(segs) else None
            before = segs[n - 1] if n else None
            if after and after['modofs'] is not None and after['ofs'] == seg['ofs'] + seg['size']:
                seg['modofs'] = after['modofs'] - seg['size']
                seg['found'] = 'position against %s' % after['name']
            elif before and before['modofs'] is not None and not before.get('modsize') \
                    and seg['ofs'] == before['ofs'] + before['size']:
                seg['modofs'] = before['modofs'] + before['size']
                seg['found'] = 'position against %s' % before['name']


def size_segments(segs):
    """A resized segment has to come out whole rather than truncated at its
    stock length. Where a segment's own structure did not give a size, the gap
    to the next segment is the only measure - but only where the two really are
    adjacent. Most are not: the whole asset file area sits between sequences and
    texturesdata, for instance, so that gap moves with the files, not with the
    segment."""
    for n, seg in enumerate(segs):
        if seg.get('modsize'):
            seg['resized'] = seg['modsize'] != seg['size']
            continue
        seg['modsize'] = seg['size']
        if n + 1 < len(segs) and not segs[n + 1].get('assumed') and not seg.get('assumed'):
            gapstock = segs[n + 1]['ofs'] - seg['ofs']
            if gapstock != seg['size']:
                continue
            gapmod = segs[n + 1]['modofs'] - seg['modofs']
            if gapmod != gapstock and 0 < gapmod:
                seg['modsize'] = gapmod
                seg['resized'] = True


# -- textures ---------------------------------------------------------------

def texture_offsets(listdata):
    """textureslist is an array of struct texture; the low 24 bits of the first
    word are the texture's offset into texturesdata (see preprocessTexturesList
    and texdecompress.c)."""
    return [int.from_bytes(listdata[i + 1:i + 4], 'big') for i in range(0, len(listdata) - 7, 8)]


def split_textures(stocklist, stockdata, modlist, moddata):
    """Per texture replacements, but only when the mod kept the texture table
    identical. Once the offsets move, an overridden list and a stock data
    segment disagree for every texture the mod did not replace, so the caller
    has to ship both segments whole instead."""
    if stocklist != modlist:
        return None

    offsets = texture_offsets(stocklist)
    changed = {}

    for n in range(len(offsets) - 1):
        start, end = offsets[n], offsets[n + 1]
        if start == end or end > len(stockdata) or end > len(moddata):
            continue
        if stockdata[start:end] != moddata[start:end]:
            if end - start > MAX_TEXTURE_SIZE:
                return None  # too big for the port's load buffer; ship the segment
            changed[n] = moddata[start:end]

    return changed


# -- output -----------------------------------------------------------------

def write_file(outdir, relpath, content, dryrun):
    path = os.path.join(outdir, relpath)
    if not dryrun:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'wb') as fd:
            fd.write(content)
    return len(content)


def verify_segment_table():
    """Warn if romdata.c has moved on without us."""
    here = os.path.dirname(os.path.abspath(__file__))
    src = os.path.join(here, '..', 'port', 'src', 'romdata.c')
    if not os.path.exists(src):
        return
    with open(src, 'r') as fd:
        text = fd.read()

    found = re.findall(
        r'ROMSEG_DECL_SEG\(\s*(\w+),\s*(0x[0-9a-f]+),\s*(0x[0-9a-f]+),\s*(0x[0-9a-f]+),\s*(0x[0-9a-f]+)',
        text)
    if not found:
        return

    theirs = [(n, int(s, 16), int(a, 16), int(b, 16), int(c, 16)) for (n, a, b, c, s) in found]
    ours = [(n, s, a, b, c) for (n, s, a, b, c) in SEGMENTS]
    if theirs != ours:
        log('warning: the segment table here does not match port/src/romdata.c.')
        log('         Segment offsets may be wrong; update SEGMENTS in this script.')


def main():
    ap = argparse.ArgumentParser(
        description='Import a console mod (ROM patch) into a mod directory for the port.')
    ap.add_argument('--rom', required=True, help='the stock ROM, e.g. pd.ntsc-final.z64')
    ap.add_argument('--patch', help='the mod patch (xdelta, BPS or IPS)')
    ap.add_argument('--patched-rom', help='an already patched ROM, instead of --patch')
    ap.add_argument('--out', required=True, help='mod directory to write')
    ap.add_argument('--keep-patched-rom', metavar='PATH', help='also save the patched ROM here')
    ap.add_argument('--dry-run', action='store_true', help='report what would be written')
    args = ap.parse_args()

    if bool(args.patch) == bool(args.patched_rom):
        die('pass exactly one of --patch or --patched-rom.')

    with open(args.rom, 'rb') as fd:
        stock = fd.read()

    if len(stock) != ROM_SIZE:
        die('%s is %u bytes; a Perfect Dark ROM is %u. Is it byteswapped (.n64/.v64) or an archive?'
            % (args.rom, len(stock), ROM_SIZE))

    romid = identify_rom(stock)
    if romid is None:
        die('%s is not a supported Perfect Dark ROM (need ntsc-final, pal-final or jpn-final).' % args.rom)

    verify_segment_table()

    workdir = tempfile.mkdtemp(prefix='importmod')
    try:
        if args.patch:
            mod, kind = apply_patch(args.rom, stock, args.patch, workdir)
        else:
            with open(args.patched_rom, 'rb') as fd:
                mod = fd.read()
            kind = 'pre-patched ROM'

        if args.keep_patched_rom and not args.dry_run:
            with open(args.keep_patched_rom, 'wb') as fd:
                fd.write(mod)

        run(stock, mod, romid, kind, args)
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


def read_datasym(romid):
    """tools/pd.<romid>.datasym, if it is beside us: `<addr> <name>` per symbol."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'pd.%s.datasym' % romid)
    syms = {}
    if os.path.exists(path):
        with open(path) as fd:
            for line in fd:
                parts = line.split()
                if len(parts) == 2:
                    syms[parts[1]] = int(parts[0], 16)
    return syms



def load_modcodediff():
    """modcodediff knows how to pull the game binary out of a ROM."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'modcodediff')
    loader = importlib.machinery.SourceFileLoader('modcodediff', path)
    spec = importlib.util.spec_from_loader('modcodediff', loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def address_pairs(code):
    """Every lui and the instruction after it that completes an address, as
    {index of the lui: address formed}. What the game code reaches its tables
    through."""
    words = [int.from_bytes(code[i:i + 4], 'big') for i in range(0, len(code) - 3, 4)]
    pairs = {}
    for i, x in enumerate(words):
        if (x >> 16) & 0xfc00 != 0x3c00:
            continue
        rt = (x >> 16) & 0x1f
        for j in range(i + 1, min(i + 4, len(words))):
            y = words[j]
            op = y >> 26
            if (y >> 21) & 0x1f == rt and op in (0x08, 0x09, 0x20, 0x21, 0x23, 0x24, 0x25, 0x28, 0x29, 0x2b):
                addr = ((x & 0xffff) << 16) + (y & 0xffff)
                if y & 0x8000:
                    addr -= 0x10000
                pairs[i] = addr & 0xffffffff
                break
    return pairs


def follow_table(stockpairs, modpairs, stockaddr, size):
    """Where the mod's code keeps a table the stock code kept at stockaddr.

    A mod that patched its code in place left every lui/addiu pair where it
    was and changed the numbers in it, so the pairs that formed the stock
    address now form the new one. The compiler folds field offsets into the
    pair, so any pair landing inside the table counts and the offset is taken
    back off. One landing just before it does not, however close: the word
    before g_MpWeaponSets is the end of g_MpWeapons, and a loop over that table
    holds a pointer to it. Returns (address, votes), or (None, 0).
    """
    votes = {}
    for i, formed in stockpairs.items():
        delta = formed - stockaddr
        if 0 <= delta < size and i in modpairs:
            got = (modpairs[i] - delta) & 0xffffffff
            votes[got] = votes.get(got, 0) + 1
    if not votes:
        return None, 0
    best = max(votes.items(), key=lambda kv: kv[1])
    return best


def follow_immediate(stockcode, modcode, start, end, stockvalue):
    """The immediate a function loads, as the mod's code has it: the `li v0,39`
    in mp_get_num_mpweapons is where the ROM says how long its Combat Simulator
    weapon list is. Returns None when the stock instruction is not there or the
    mod's word at that spot is not the same instruction with another number."""
    for ofs in range(start, min(end, len(stockcode) - 3), 4):
        x = int.from_bytes(stockcode[ofs:ofs + 4], 'big')
        if (x >> 26) in (0x08, 0x09) and (x >> 21) & 0x1f == 0 and (x & 0xffff) == stockvalue:
            y = int.from_bytes(modcode[ofs:ofs + 4], 'big')
            if (y >> 16) == (x >> 16):
                return y & 0xffff
            return None
    return None


def follow_immediates(stockcode, modcode, start, end):
    """Every `li rt,N` (addiu rt,zero,N) in [start, end) whose immediate the
    mod changed, as {stock N: mod N}; the first occurrence of a stock value
    wins."""
    pairs = {}
    for ofs in range(start, min(end, len(stockcode) - 3), 4):
        x = int.from_bytes(stockcode[ofs:ofs + 4], 'big')
        if (x >> 26) in (0x08, 0x09) and (x >> 21) & 0x1f == 0:
            y = int.from_bytes(modcode[ofs:ofs + 4], 'big')
            if (y >> 16) == (x >> 16) and (y & 0xffff) != (x & 0xffff):
                pairs.setdefault(x & 0xffff, y & 0xffff)
    return pairs


def read_codesym(romid):
    """tools/pd.<romid>.sym, name -> (start, end)."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'pd.%s.sym' % romid)
    syms = []
    if os.path.exists(path):
        with open(path) as fd:
            for line in fd:
                parts = line.split()
                if len(parts) == 2:
                    syms.append((int(parts[0], 16), parts[1]))
    syms.sort()
    out = {}
    for i, (addr, name) in enumerate(syms):
        end = syms[i + 1][0] if i + 1 < len(syms) else addr + 0x400
        out[name] = (addr, end)
    return out


def count_mpweapons(seg, base, addr, limit=64):
    """How many entries at addr read as Combat Simulator weapons."""
    n = 0
    while n < limit:
        ofs = addr - base + n * 10
        if ofs + 10 > len(seg):
            break
        e = seg[ofs:ofs + 10]
        weaponnum, pri, sec = e[0], e[1], e[3]
        model = int.from_bytes(e[6:8], 'big', signed=True)
        if weaponnum > 0x5d or (pri > 0x21 and pri < 0x80) or (sec > 0x21 and sec < 0x80) or not 0 <= model < 0x1b9:
            break
        n += 1
    return n


def count_mpweaponsets(seg, base, addr, numweapons, limit=32):
    n = 0
    while n < limit:
        ofs = addr - base + n * 18
        if ofs + 18 > len(seg):
            break
        e = seg[ofs:ofs + 18]
        name = int.from_bytes(e[0:2], 'big')
        # slots are weapon numbers, with 0x5b (the shield) and 0x5c (disabled) as sentinels
        if (name >> 9) > 0x40 or any(slot > 0x5d for slot in e[2:8]):
            break
        n += 1
    return n

def count_mparenas(seg, base, addr, limit=64):
    """How many entries at addr read as Combat Simulator arenas: a stage
    number (1 is "Random"), an unlock feature, a text id in a bank that
    exists."""
    n = 0
    while n < limit:
        ofs = addr - base + n * 6
        if ofs + 6 > len(seg):
            break
        e = seg[ofs:ofs + 6]
        stagenum = int.from_bytes(e[0:2], 'big', signed=True)
        feature = e[2]
        name = int.from_bytes(e[4:6], 'big')
        if not 1 <= stagenum <= 0x5d or feature > 0x7f or name == 0 or (name >> 9) > 0x44:
            break
        n += 1
    return n


def count_headsandbodies(seg, base, addr, limit):
    """Entries to the terminator: a file number, and scales in a sane range."""
    n = 0
    while n < limit:
        ofs = addr - base + n * 0x14
        if ofs + 0x14 > len(seg):
            break
        filenum = be16(seg, ofs + 2)
        scale, animscale = struct.unpack('>ff', seg[ofs + 4:ofs + 12])
        if filenum == 0:
            break
        if not (0.01 < scale < 100 and 0.01 < animscale < 100):
            return 0
        n += 1
    return n


def count_mpheads(seg, base, addr, limit):
    n = 0
    while n < limit:
        ofs = addr - base + n * 4
        if ofs + 4 > len(seg):
            break
        headnum = int.from_bytes(seg[ofs:ofs + 2], 'big', signed=True)
        if not 0 <= headnum < 151 or seg[ofs + 2] > 0x7f:
            break
        n += 1
    return n


def count_mpbodies(seg, base, addr, limit):
    n = 0
    while n < limit:
        ofs = addr - base + n * 8
        if ofs + 8 > len(seg):
            break
        bodynum = int.from_bytes(seg[ofs:ofs + 2], 'big', signed=True)
        headnum = int.from_bytes(seg[ofs + 4:ofs + 6], 'big', signed=True)
        # head 1000 is "the body has its own"
        if not 0 <= bodynum < 151 or not (-1 <= headnum < 151 or headnum == 1000) or seg[ofs + 6] > 0x7f or (be16(seg, ofs + 2) >> 9) > 0x44:
            break
        n += 1
    return n


def count_solostages(seg, base, addr, limit):
    """Entries of g_SoloStages that read as one: a stage number, 12 bytes each."""
    n = 0
    while n < limit:
        ofs = addr - base + n * 12
        if ofs + 12 > len(seg):
            break
        stagenum = be32(seg, ofs)
        if not 0 < stagenum < 0x60:
            break
        n += 1
    return n


def count_stages(seg, base, addr, limit):
    """Entries of g_Stages that read as one: a stage number, 0x38 bytes each."""
    n = 0
    while n < limit:
        ofs = addr - base + n * 0x38
        if ofs + 0x38 > len(seg):
            break
        stagenum = int.from_bytes(seg[ofs:ofs + 2], 'big', signed=True)
        if not 0 < stagenum < 0x60:
            break
        n += 1
    return n


def count_indexes(seg, base, addr, limit, maxvalue):
    n = 0
    while n < limit:
        ofs = addr - base + n * 4
        if ofs + 4 > len(seg) or be32(seg, ofs) >= maxvalue:
            break
        n += 1
    return n


def write_data_segment(stock, mod, romid, outdir, dryrun):
    """The mod's inflated data segment, its file names, and a modconfig block
    saying where its tables are.

    The weapon definitions and the model, Combat Simulator and weapon set
    tables are .data - compiled into the game, in the ROM's data segment, not
    in any file - and a mod that brings its own guns rewrites them there. The
    port rebuilds them from the segment at load (port/src/moddata.c); it needs
    the segment, the names its file ids mean, and the addresses.

    The addresses are the stock ones when the mod patched the segment in
    place, which the symbol file knows. A rebuilt segment has its own, and
    nothing here finds them yet: the block is left out and the report says so.
    """
    _, stockseg, stockfilesofs = find_data_segment(stock, ROMS[romid]['data'])
    dataofs, seg, filesofs = find_data_segment(mod, ROMS[romid]['data'])
    if seg is None:
        return 0, None

    _, names = read_file_table(mod, seg, filesofs)
    if names is None:
        names = []

    written = write_file(outdir, 'segs/data', seg, dryrun)
    written += write_file(outdir, 'segs/data.names',
                          '\n'.join(n or '' for n in names).encode('utf-8'), dryrun)

    syms = read_datasym(romid)
    if not syms or 'g_FileTable' not in syms:
        return written, 'no data symbols for %s (tools/pd.%s.datasym), so the tables in it cannot be located' % (romid, romid)

    base = syms['g_FileTable'] - stockfilesofs

    if len(seg) != len(stockseg) or filesofs != stockfilesofs:
        return written, ('the data segment was rebuilt (%d bytes against %d), so its tables are not at the\n'
                         '           stock addresses and the port cannot read them yet' % (len(seg), len(stockseg)))

    # Where each table is now. A mod may move one - GE-X rebuilt the Combat
    # Simulator list somewhere else and left junk at the stock address - and
    # the only thing that knows is its code, which still reaches every table
    # through the same lui/addiu pairs, now holding the new address.
    mcd = load_modcodediff()
    stocktab = mcd.find_game_table(stock, mcd.GAME_TABLE.get(romid))
    modtab = mcd.find_game_table(mod, mcd.GAME_TABLE.get(romid))
    stockcode = mcd.extract_game(stock, stocktab) if stocktab else b''
    modcode = mcd.extract_game(mod, modtab) if modtab else b''
    followed = len(stockcode) == len(modcode) and len(stockcode) > 0
    stockpairs = address_pairs(stockcode) if followed else {}
    modpairs = address_pairs(modcode) if followed else {}

    # sizes from the symbol spacing, so a build that grows a table is followed
    ordered = sorted(syms.items(), key=lambda kv: kv[1])
    ends = { name: (ordered[i + 1][1] if i + 1 < len(ordered) else addr) for i, (name, addr) in enumerate(ordered) }

    def locate(name):
        if name not in syms:
            return None, ''
        if not followed:
            return syms[name], ''
        addr, votes = follow_table(stockpairs, modpairs, syms[name], ends[name] - syms[name])
        if addr is None:
            return syms[name], ''
        if addr != syms[name]:
            return addr, ' (moved from %08x; %d references in the code agree)' % (syms[name], votes)
        return addr, ''

    def stockcount(name, elem):
        return (ends[name] - syms[name]) // elem if name in syms else 0

    lines = []
    notes = []

    weapons, note = locate('g_Weapons')
    if weapons:
        lines.append('  weapons 0x%08x %d' % (weapons, stockcount('g_Weapons', 4)))
        notes.append('weapons at %08x%s' % (weapons, note))

    models, note = locate('g_ModelStates')
    if models:
        lines.append('  modelstates 0x%08x %d' % (models, stockcount('g_ModelStates', 8)))
        notes.append('model states at %08x%s' % (models, note))

    # the lengths are numbers in the code, and the code is the authority;
    # counting entries that read as one is the fallback
    codesyms = read_codesym(romid) if followed else {}

    mpweapons, note = locate('g_MpWeapons')
    nummp = 0
    if mpweapons:
        if 'mp_get_num_mpweapons' in codesyms:
            start, end = codesyms['mp_get_num_mpweapons']
            nummp = follow_immediate(stockcode, modcode, start - 0x7f000000, end - 0x7f000000,
                                     stockcount('g_MpWeapons', 10)) or 0
        if not nummp:
            nummp = count_mpweapons(seg, base, mpweapons)
        elif count_mpweapons(seg, base, mpweapons, nummp) < nummp:
            notes.append('the code says %d Combat Simulator weapons but fewer read as one' % nummp)
            nummp = count_mpweapons(seg, base, mpweapons, nummp)
    if mpweapons and nummp:
        lines.append('  mpweapons 0x%08x %d' % (mpweapons, nummp))
        notes.append('%d Combat Simulator weapons at %08x%s' % (nummp, mpweapons, note))
    elif mpweapons:
        notes.append('what is at %08x does not read as the Combat Simulator weapon list; left out' % mpweapons)

    mpsets, note = locate('g_MpWeaponSets')
    numsets = 0
    if mpsets:
        # likewise: mp_get_num_weaponset_slots loads the count of sets
        if 'mp_get_num_weaponset_slots' in codesyms:
            start, end = codesyms['mp_get_num_weaponset_slots']
            numsets = follow_immediate(stockcode, modcode, start - 0x7f000000, end - 0x7f000000,
                                       stockcount('g_MpWeaponSets', 18)) or 0
        if not numsets:
            numsets = count_mpweaponsets(seg, base, mpsets, nummp)
        elif count_mpweaponsets(seg, base, mpsets, nummp, numsets) < numsets:
            notes.append('the code says %d weapon sets but fewer read as one' % numsets)
            numsets = count_mpweaponsets(seg, base, mpsets, nummp, numsets)
    if mpsets and numsets:
        lines.append('  mpweaponsets 0x%08x %d' % (mpsets, numsets))
        notes.append('%d weapon sets at %08x%s' % (numsets, mpsets, note))
    elif mpsets:
        notes.append('what is at %08x does not read as the weapon set table; left out' % mpsets)

    # the arena list: mp_get_num_stages loads its length. A mod that adds
    # solo stages to the Combat Simulator grows it, and since the stock table
    # has no room after it, moves it.
    arenas, note = locate('g_MpArenas')
    numarenas = 0
    if arenas:
        if 'mp_get_num_stages' in codesyms:
            start, end = codesyms['mp_get_num_stages']
            numarenas = follow_immediate(stockcode, modcode, start - 0x7f000000, end - 0x7f000000, 17) or 0
        if not numarenas:
            numarenas = count_mparenas(seg, base, arenas)
        elif count_mparenas(seg, base, arenas, numarenas) < numarenas:
            # CSMP and CVMP rebuilt the entry as 4 bytes; a list read with the
            # wrong stride is no list, and a short one is a broken menu
            notes.append('the code says %d arenas but only %d read as one at %08x; the arena list is left out'
                         % (numarenas, count_mparenas(seg, base, arenas, numarenas), arenas))
            numarenas = 0
            arenas = None
    if arenas and numarenas:
        lines.append('  mparenas 0x%08x %d' % (arenas, numarenas))
        notes.append('%d arenas at %08x%s' % (numarenas, arenas, note))
    elif arenas:
        notes.append('what is at %08x does not read as the arena list; left out' % arenas)

    # the characters: g_HeadsAndBodies is what setups, the Combat Simulator
    # lists and the bot profiles index, and a mod with its own roster (Mario
    # Characters) rewrites it in place. Its length is the terminator; the
    # Combat Simulator lists have theirs in the code, like the weapons.
    hab, note = locate('g_HeadsAndBodies')
    if hab:
        n = count_headsandbodies(seg, base, hab, stockcount('g_HeadsAndBodies', 0x14))
        if n:
            lines.append('  headsandbodies 0x%08x %d' % (hab, n))
            notes.append('%d heads and bodies at %08x%s' % (n, hab, note))
        else:
            notes.append('what is at %08x does not read as the heads and bodies table; left out' % hab)

    for key, sym, fn, elem, limit in (('mpheads', 'g_MpHeads', 'mp_get_num_heads', 4, 151),
                                      ('mpbodies', 'g_MpBodies', 'mp_get_num_bodies', 8, 151),
                                      ('mpbeauheads', 'g_MpBeauHeads', None, 4, 151),
                                      ('botheads', 'g_BotHeads', None, 4, 75),
                                      ('mpmaleheads', 'g_MpMaleHeads', None, 4, 151),
                                      ('mpfemaleheads', 'g_MpFemaleHeads', None, 4, 151)):
        addr, note = locate(sym)
        if not addr:
            continue
        n = stockcount(sym, elem)
        if fn and fn in codesyms:
            start, end = codesyms[fn]
            n = follow_immediate(stockcode, modcode, start - 0x7f000000, end - 0x7f000000, n) or n
        if elem == 8:
            ok = count_mpbodies(seg, base, addr, n)
        elif key in ('mpheads', 'mpbeauheads'):
            ok = count_mpheads(seg, base, addr, n)
        else:
            ok = count_indexes(seg, base, addr, n, limit)
        if ok == n:
            lines.append('  %s 0x%08x %d' % (key, addr, n))
            notes.append('%d %s at %08x%s' % (n, key, addr, note))
        else:
            notes.append('the code says %d %s but only %d read as one at %08x; left out' % (n, key, ok, addr))

    # the stage table: which background, pads and setup each stage loads, and
    # the lighting and fog around them. A mod that puts its own levels in the
    # stock slots (GE-X: Runway in Extraction's) points them at its own files
    stages, note = locate('g_Stages')
    if stages:
        n = count_stages(seg, base, stages, stockcount('g_Stages', 0x38))
        if n:
            lines.append('  stages 0x%08x %d' % (stages, n))
            notes.append('%d stages at %08x%s' % (n, stages, note))
        else:
            notes.append('what is at %08x does not read as the stage table; left out' % stages)

    # the mission list: which stage each solo mission slot loads and its
    # title ids. GE-X moves six missions to stage ids the menu never used
    solo, note = locate('g_SoloStages')
    if solo:
        n = count_solostages(seg, base, solo, stockcount('g_SoloStages', 12))
        if n:
            lines.append('  solostages 0x%08x %d' % (solo, n))
            notes.append('%d solo missions at %08x%s' % (n, solo, note))

    # the AI command length table: a mod's own commands sit in slots this
    # game has no handler for, and their lengths let the port step over them
    cl, note = locate('g_CommandLengths')
    if cl:
        n = stockcount('g_CommandLengths', 2)
        if n:
            lines.append('  commandlengths 0x%08x %d' % (cl, n))
            notes.append('%d AI command lengths at %08x%s' % (n, cl, note))

    # the solo player's body and head, per outfit, are constants in the code
    # that chooses them; a mod with its own hero (GE-X: Bond, 47 constants)
    # changed the numbers. Every `li` the function loads that the mod changed
    # goes out as stock=mod, and the port looks each site's constant up.
    if followed and 'player_choose_body_and_head' in codesyms:
        start, end = codesyms['player_choose_body_and_head']
        pairs = follow_immediates(stockcode, modcode, start - 0x7f000000, end - 0x7f000000)
        if pairs:
            for k, v in sorted(pairs.items()):
                lines.append('  playerconst 0x%x %d' % (k, v))
            notes.append('%d body/head constants changed in the mod\'s outfit code: %s'
                         % (len(pairs), ', '.join('%#x->%d' % (k, v) for k, v in sorted(pairs.items()))))

    block = ('# The mod\'s ROM data segment, and where its tables are in it. The port rebuilds\n'
             '# the weapon definitions and the model tables from this at load; weapon blocks\n'
             '# after it edit what it put in place. Written by tools/importmod.\n'
             'datasegment {\n'
             '  file "segs/data"\n'
             '  names "segs/data.names"\n'
             '  base 0x%08x\n' % base
             + '\n'.join(lines) + ('\n' if lines else '')
             + '}\n')
    for n in notes:
        log('  %s' % n)

    path = os.path.join(outdir, 'modconfig.txt')
    existing = ''
    if os.path.exists(path):
        with open(path) as fd:
            existing = fd.read()
        # replace an earlier block of ours rather than stacking them
        existing = re.sub(r'(#[^\n]*\n)*datasegment \{[^}]*\}\n*', '', existing)
    written += write_file(outdir, 'modconfig.txt', (block + '\n' + existing).encode('utf-8'), dryrun)

    return written, None


def run(stock, mod, romid, kind, args):
    outdir = args.out
    dryrun = args.dry_run

    log('stock ROM:   %s (%s, md5 %s)' % (args.rom, romid, hashlib.md5(stock).hexdigest()))
    log('patch:       %s (%s)' % (args.patch or args.patched_rom, kind))
    log('patched ROM: %u bytes, md5 %s' % (len(mod), hashlib.md5(mod).hexdigest()))

    if len(mod) != len(stock):
        log('warning: the patched ROM is %u bytes, not %u. Offsets past the end will be skipped.'
            % (len(mod), len(stock)))

    modid = identify_rom(mod)
    if modid is None:
        log('note:    the patched ROM has a modified header; the port would reject it directly.')
    elif modid != romid:
        die('the patched ROM identifies as %s but the stock ROM is %s.' % (modid, romid))
    log()

    written = 0
    counts = { 'changed': 0, 'new': 0, 'segs': 0, 'textures': 0 }

    # -- asset files
    stockfiles, stockdataofs, stockfilesofs = read_files(stock, romid, 'stock')
    modfiles, moddataofs, modfilesofs = read_files(mod, romid, 'patched')

    if moddataofs != stockdataofs or modfilesofs != stockfilesofs:
        log('note:    this mod moved the data segment to %06x (port expects %06x) and its'
            % (moddataofs, stockdataofs))
        log('         file table to %05x (port expects %05x). Both are hardcoded in'
            % (modfilesofs, stockfilesofs))
        log('         romdata.c, so the port could not read this ROM directly in any case.')
        log()

    log('files: %u in the stock ROM, %u in the patched one' % (len(stockfiles), len(modfiles)))

    incompatible = []
    stripped = 0

    for name in sorted(modfiles):
        content = modfiles[name]
        isnew = name not in stockfiles
        if not isnew and content_equal(stockfiles[name], content):
            continue
        if not content:
            # Mods empty the files they do not need (usually the other
            # languages) to make room in the ROM. An empty override would
            # only be ignored by the port (romdataFileLoad() requires a
            # size above 0), so leave it out and say so once.
            stripped += 1
            continue

        reason = check_file(name, content)
        if reason:
            # the port would not reject this, it would crash on it
            incompatible.append((name, reason))
            write_file(outdir, 'files.incompatible/' + name, content, dryrun)
            continue

        counts['new' if isnew else 'changed'] += 1
        written += write_file(outdir, 'files/' + name, content, dryrun)
        log('  %s  files/%s (%u bytes)' % ('new    ' if isnew else 'changed', name, len(content)))

    if stripped:
        log('  %u stock file(s) are emptied in the mod (space reclaimed); the port keeps its own copies' % stripped)

    missing = [n for n in stockfiles if n not in modfiles]
    if missing:
        log('  %u stock file(s) are absent from the mod; the port keeps its own copies' % len(missing))

    if incompatible:
        log()
        log('  %u changed file(s) are not in the format the port reads:' % len(incompatible))
        reasons = {}
        for name, reason in incompatible:
            reasons.setdefault(reason, []).append(name)
        for reason in sorted(reasons, key=lambda r: -len(reasons[r])):
            names = reasons[reason]
            shown = ', '.join(sorted(names)[:4]) + (', ...' if len(names) > 4 else '')
            log('    %u file(s): %s' % (len(names), reason))
            log('      %s' % shown)
        log('  This mod built them for its own copy of the game code, which reads them')
        log('  differently. The port would crash on them rather than ignore them, so they')
        log('  are in files.incompatible/, which the port does not read.')
    log()

    # -- segments
    segs = match_segments(stock, mod, romid)
    changedsegs = []

    for seg in segs:
        seg['shift'] = seg['modofs'] - seg['ofs']
        if stock[seg['ofs']:seg['ofs'] + seg['size']] != mod[seg['modofs']:seg['modofs'] + seg['modsize']]:
            changedsegs.append(seg)

    shifts = sorted(set(s['shift'] for s in segs))
    log('segments: %u, shifted by %s' %
        (len(segs), ', '.join('%+d' % s for s in shifts) if shifts != [0] else 'nothing (same layout)'))

    for seg in segs:
        if seg.get('found'):
            log('  found %s by its %s at %08x' % (seg['name'], seg['found'], seg['modofs']))
        elif seg['note'] == 'ambiguous':
            log('  warning: %s matched in more than one place; took the first at %08x'
                % (seg['name'], seg['modofs']))

    bynames = { s['name']: s for s in segs }
    texsplit = None
    if bynames.get('texturesdata') in changedsegs or bynames.get('textureslist') in changedsegs:
        td, tl = bynames['texturesdata'], bynames['textureslist']
        if not td.get('assumed') and not tl.get('assumed'):
            texsplit = split_textures(
                stock[tl['ofs']:tl['ofs'] + tl['size']], stock[td['ofs']:td['ofs'] + td['size']],
                mod[tl['modofs']:tl['modofs'] + tl['modsize']], mod[td['modofs']:td['modofs'] + td['modsize']])

    unlocated = []

    for seg in changedsegs:
        if texsplit is not None and seg['name'] in ('texturesdata', 'textureslist'):
            continue
        data = mod[seg['modofs']:seg['modofs'] + seg['modsize']]
        guessed = seg.get('assumed') or (
            # placed against a neighbour, somewhere other than where it was,
            # and not holding the stock bytes: nothing actually found it. The
            # segment may not be there at all - Suburb's tool dropped the
            # Japanese fonts, which the NTSC game never draws, and what sits
            # against its animations is file data.
            str(seg.get('found', '')).startswith('position against')
            and seg['modofs'] != seg['ofs']
            and data[:64] != stock[seg['ofs']:seg['ofs'] + 64])
        if guessed:
            # its position is a guess, so keep it out of the way rather than
            # hand the port a segment that is probably off by some bytes
            unlocated.append(seg)
            write_file(outdir, 'segs.unlocated/' + seg['name'], data, dryrun)
            continue
        counts['segs'] += 1
        note = ' (resized %+d)' % (seg['modsize'] - seg['size']) if seg.get('resized') else ''
        written += write_file(outdir, 'segs/' + seg['name'], data, dryrun)
        log('  changed  segs/%s (%u bytes)%s' % (seg['name'], seg['modsize'], note))

    if texsplit is not None:
        for num in sorted(texsplit):
            counts['textures'] += 1
            written += write_file(outdir, 'textures/%04x.bin' % num, texsplit[num], dryrun)
        log('  changed  %u texture(s) -> textures/*.bin (the texture table is unchanged,'
            % counts['textures'])
        log('           so they can go in one at a time instead of as whole segments)')

    log()
    datawritten, datanote = write_data_segment(stock, mod, romid, outdir, dryrun)
    written += datawritten
    if datawritten:
        log('data segment: segs/data (%u bytes), the weapon definitions and model tables' % datawritten)
        if datanote:
            log('  note:    %s' % datanote)
        else:
            log('  and a datasegment block in modconfig.txt saying where its tables are')
    if unlocated:
        log()
        log('  %u segment(s) changed but could not be found in the patched ROM:' % len(unlocated))
        log('    %s' % ', '.join(s['name'] for s in unlocated))
        log('  Nothing left in them to fingerprint and no structure to go by, so their')
        log('  offsets are only inferred from the segments around them. They are in')
        log('  segs.unlocated/, which the port ignores. Move one into segs/ to try it.')
    log()

    # -- what could not come across
    firstseg = min(s['ofs'] for s in segs)
    common = os.path.commonprefix([stock[:firstseg], mod[:firstseg]])
    if len(common) < firstseg:
        log('the first %u bytes of the ROM - boot code, game code and the compressed data' % firstseg)
        log('segment - differ from 0x%06x onwards. The port runs decomp code rather than the'
            % len(common))
        log('ROM\'s, so whatever this mod changed there is NOT imported and will have no effect.')
        log()

    log('imported %u changed file(s), %u new file(s), %u segment(s), %u texture(s) - %.1f MB'
        % (counts['changed'], counts['new'], counts['segs'], counts['textures'], written / 1048576.0))
    if incompatible or unlocated:
        log('set aside %u file(s) and %u segment(s) the port cannot use'
            % (len(incompatible), len(unlocated)))
    if not (counts['changed'] or counts['new'] or counts['segs'] or counts['textures']):
        log()
        log('Nothing in this mod carries over. What it changes is either ROM code, which the')
        log('port does not run, or assets in a format only its own code reads.')

    if dryrun:
        log()
        log('(dry run: nothing was written)')
        return

    if counts['changed'] or counts['new'] or counts['segs'] or counts['textures']:
        log()
        log('run it with:  pd --moddir %s' % outdir)

    with open(os.path.join(outdir, 'IMPORT.txt'), 'w') as fd:
        fd.write('\n'.join(REPORT) + '\n')


if __name__ == '__main__':
    main()
